# Copy this file to .env, then replace the values (never commit .env)

# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: change the AI model without touching the code
# GROQ_MODEL=openai/gpt-oss-120b

# Server port
PORT=5000

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/cvision?retryWrites=true&w=majority

# JWT secret: generate it with
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_random_64_char_hex_secret_here

# Verification emails: Google Apps Script relay (see the README)
# Leave both empty in local development: the code is printed in the backend terminal.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_SECRET=

# Alternatives, only if you use one of them
# MAILJET_API_KEY=
# MAILJET_SECRET_KEY=
# BREVO_API_KEY=
# MAIL_FROM=