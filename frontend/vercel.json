{
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data:; connect-src 'self' https://cv-analyzer-zuyf.onrender.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/og-image.png", "destination": "/public/og-image.png" },
    { "source": "/favicon.ico", "destination": "/public/favicon.ico" },
    { "source": "/favicon-16x16.png", "destination": "/public/favicon-16x16.png" },
    { "source": "/favicon-32x32.png", "destination": "/public/favicon-32x32.png" },
    { "source": "/apple-touch-icon.png", "destination": "/public/apple-touch-icon.png" },
    { "source": "/android-chrome-192x192.png", "destination": "/public/android-chrome-192x192.png" },
    { "source": "/android-chrome-512x512.png", "destination": "/public/android-chrome-512x512.png" },
    { "source": "/logo-mark.svg", "destination": "/public/logo-mark.svg" },
    { "source": "/site.webmanifest", "destination": "/public/site.webmanifest" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "cleanUrls": true
}