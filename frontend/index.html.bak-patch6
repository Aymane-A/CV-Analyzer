<!DOCTYPE html>
<html lang="en" data-theme="dark">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CVision — Intelligent CV Analyzer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">

  <style>
    /* ═══════════════════════════════════════════ TOKENS ═══ */
    :root {
      --bg-base: #0d0e12;
      --bg-surface: #13151c;
      --bg-card: #191c26;
      --bg-card-hover: #1f2333;
      --bg-input: #111420;
      --border: rgba(255, 255, 255, 0.07);
      --border-hover: rgba(200, 170, 100, 0.35);
      --gold: #c8aa64;
      --gold-light: #e2cd96;
      --gold-dim: rgba(200, 170, 100, 0.15);
      --gold-glow: rgba(200, 170, 100, 0.25);
      --text-primary: #edeae0;
      --text-secondary: #9a9484;
      --text-muted: #5a5650;
      --green: #4ade80;
      --amber: #fb923c;
      --red: #f87171;
      --blue: #60a5fa;
      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --shadow-card: 0 4px 40px rgba(0, 0, 0, 0.45), 0 1px 0 rgba(255, 255, 255, 0.04) inset;
      --shadow-glow: 0 0 60px rgba(200, 170, 100, 0.12);
      --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    [data-theme="light"] {
      --bg-base: #f5f3ee;
      --bg-surface: #ede9e0;
      --bg-card: #ffffff;
      --bg-card-hover: #faf8f4;
      --bg-input: #f0ede6;
      --border: rgba(0, 0, 0, 0.08);
      --border-hover: rgba(160, 120, 40, 0.4);
      --gold: #a07830;
      --gold-light: #c49a40;
      --gold-dim: rgba(160, 120, 40, 0.1);
      --gold-glow: rgba(160, 120, 40, 0.15);
      --text-primary: #1a1712;
      --text-secondary: #6b6355;
      --text-muted: #a09a90;
      --shadow-card: 0 4px 24px rgba(0, 0, 0, 0.08), 0 1px 0 rgba(255, 255, 255, 0.8) inset;
      --shadow-glow: 0 0 60px rgba(160, 120, 40, 0.08);
    }

    /* ═══ RESET ═══ */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'DM Sans', sans-serif;
      background: var(--bg-base);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
      transition: background 0.4s, color 0.4s;
    }

    ::-webkit-scrollbar {
      width: 6px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg-base);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--gold-dim);
      border-radius: 99px;
    }

    h1,
    h2,
    h3 {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 600;
      line-height: 1.15;
    }

    em {
      font-style: italic;
      color: var(--gold);
    }

    /* ═══ NAVBAR ═══ */
    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 clamp(1rem, 4vw, 2.5rem);
      height: 64px;
      background: rgba(13, 14, 18, 0.85);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
      transition: background 0.4s;
    }

    [data-theme="light"] .navbar {
      background: rgba(245, 243, 238, 0.85);
    }

    .nav-brand {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: var(--gold-dim);
      border: 1px solid var(--gold);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--gold);
      font-size: 15px;
    }

    .brand-name {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.45rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--text-primary);
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-history-btn {
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 14px;
      border: 1px solid var(--border);
      border-radius: 99px;
      background: var(--bg-card);
      color: var(--text-secondary);
      font: 500 0.8rem 'DM Sans', sans-serif;
      cursor: pointer;
      transition: var(--transition);
    }

    .nav-history-btn:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .theme-toggle {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-secondary);
      cursor: pointer;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .theme-toggle:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: var(--gold-dim);
    }

    /* ═══ HERO ═══ */
    .hero {
      position: relative;
      overflow: hidden;
      padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem) clamp(2rem, 5vw, 4rem);
      text-align: center;
    }

    .hero-bg-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      pointer-events: none;
      opacity: 0.35;
    }

    .orb-1 {
      width: 420px;
      height: 420px;
      background: radial-gradient(circle, rgba(200, 170, 100, 0.5) 0%, transparent 70%);
      top: -120px;
      left: -60px;
      animation: orbFloat 12s ease-in-out infinite;
    }

    .orb-2 {
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(96, 165, 250, 0.3) 0%, transparent 70%);
      bottom: -80px;
      right: -40px;
      animation: orbFloat 15s ease-in-out infinite reverse;
    }

    @keyframes orbFloat {

      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }

      50% {
        transform: translate(20px, 15px) scale(1.05);
      }
    }

    .hero-content {
      position: relative;
      z-index: 1;
    }

    .hero-eyebrow {
      display: inline-block;
      font-size: 0.78rem;
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--gold);
      background: var(--gold-dim);
      border: 1px solid rgba(200, 170, 100, 0.3);
      padding: 5px 14px;
      border-radius: 99px;
      margin-bottom: 1.25rem;
      animation: fadeUp 0.6s ease both;
    }

    .hero-title {
      font-size: clamp(2.4rem, 6vw, 4.5rem);
      font-weight: 300;
      color: var(--text-primary);
      margin-bottom: 1rem;
      animation: fadeUp 0.6s 0.1s ease both;
    }

    .hero-subtitle {
      font-size: clamp(0.95rem, 2vw, 1.1rem);
      color: var(--text-secondary);
      max-width: 540px;
      margin: 0 auto;
      line-height: 1.7;
      font-weight: 300;
      animation: fadeUp 0.6s 0.2s ease both;
    }

    @keyframes fadeUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ═══ CONTAINER & CARD ═══ */
    .container {
      max-width: 960px;
      margin: 0 auto;
      padding: 0 clamp(1rem, 4vw, 2rem) 4rem;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: clamp(1.25rem, 4vw, 2rem);
      box-shadow: var(--shadow-card);
      transition: var(--transition);
    }

    .card:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card), var(--shadow-glow);
    }

    .card-header {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 1.25rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .card-header h2,
    .card-header h3 {
      font-size: clamp(1.1rem, 2.5vw, 1.4rem);
      color: var(--text-primary);
    }

    .card-header-icon {
      font-size: 1.1rem;
      color: var(--gold);
    }

    .icon-green {
      color: var(--green) !important;
    }

    .icon-amber {
      color: var(--amber) !important;
    }

    .icon-gold {
      color: var(--gold) !important;
    }

    /* ═══ TABS (Upload / Compare) ═══ */
    .main-tabs {
      display: flex;
      gap: 4px;
      background: var(--bg-input);
      border-radius: 12px;
      padding: 4px;
      margin-bottom: 1.5rem;
      animation: fadeUp 0.5s 0.25s ease both;
    }

    .tab-btn {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 9px;
      background: transparent;
      color: var(--text-secondary);
      font: 500 0.88rem 'DM Sans', sans-serif;
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
    }

    .tab-btn.active {
      background: var(--bg-card);
      color: var(--gold);
      box-shadow: var(--shadow-card);
    }

    .tab-btn:hover:not(.active) {
      color: var(--text-primary);
    }

    .tab-panel {
      display: none;
    }

    .tab-panel.active {
      display: block;
    }

    /* ═══ UPLOAD ═══ */
    .upload-card {
      margin-bottom: 2rem;
      animation: fadeUp 0.5s 0.3s ease both;
    }

    .drop-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius-md);
      min-height: 180px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
      margin-bottom: 1.25rem;
    }

    .drop-zone:hover,
    .drop-zone.drag-over {
      border-color: var(--gold);
      background: var(--gold-dim);
    }

    .drop-zone.drag-over {
      transform: scale(1.01);
    }

    .drop-zone-inner {
      text-align: center;
      padding: 2rem 1rem;
    }

    .drop-icon-wrap {
      width: 60px;
      height: 60px;
      border-radius: 50%;
      background: var(--gold-dim);
      border: 1px solid rgba(200, 170, 100, 0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1rem;
      transition: var(--transition);
    }

    .drop-zone:hover .drop-icon-wrap {
      background: rgba(200, 170, 100, 0.2);
      transform: translateY(-2px);
    }

    .drop-icon {
      font-size: 1.6rem;
      color: var(--gold);
    }

    .drop-primary {
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 4px;
    }

    .drop-secondary {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin-bottom: 8px;
    }

    .drop-formats {
      font-size: 0.75rem;
      color: var(--text-muted);
      letter-spacing: 0.05em;
    }

    .inline-btn {
      background: none;
      border: none;
      color: var(--gold);
      font: inherit;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    .inline-btn:hover {
      color: var(--gold-light);
    }

    .file-selected {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 1rem 1.25rem;
      width: 100%;
      animation: fadeUp 0.3s ease;
    }

    .file-check-icon {
      font-size: 1.5rem;
      color: var(--green);
      flex-shrink: 0;
    }

    .file-info {
      flex: 1;
      overflow: hidden;
      text-align: left;
    }

    .file-name {
      display: block;
      font-weight: 500;
      font-size: 0.95rem;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .file-size {
      display: block;
      font-size: 0.78rem;
      color: var(--text-secondary);
      margin-top: 2px;
    }

    .remove-file {
      width: 30px;
      height: 30px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      transition: var(--transition);
      flex-shrink: 0;
    }

    .remove-file:hover {
      border-color: var(--red);
      color: var(--red);
      background: rgba(248, 113, 113, 0.1);
    }

    /* JD */
    .jd-section {
      margin-bottom: 1.25rem;
    }

    .jd-toggle {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 14px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text-secondary);
      font: 0.9rem/1 'DM Sans', sans-serif;
      font-weight: 500;
      cursor: pointer;
      transition: var(--transition);
      text-align: left;
    }

    .jd-toggle:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .badge-optional {
      font-size: 0.7rem;
      background: var(--gold-dim);
      color: var(--gold);
      border: 1px solid rgba(200, 170, 100, 0.25);
      border-radius: 99px;
      padding: 2px 7px;
      font-weight: 400;
    }

    .jd-chevron {
      margin-left: auto;
      transition: transform 0.3s ease;
    }

    .jd-chevron.open {
      transform: rotate(180deg);
    }

    .jd-body {
      padding-top: 12px;
      animation: fadeUp 0.3s ease;
    }

    .jd-body textarea {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      color: var(--text-primary);
      font: 0.88rem/1.6 'DM Sans', sans-serif;
      padding: 12px 14px;
      resize: vertical;
      outline: none;
      transition: var(--transition);
    }

    .jd-body textarea::placeholder {
      color: var(--text-muted);
    }

    .jd-body textarea:focus {
      border-color: var(--gold);
      background: var(--bg-card);
    }

    .jd-hint {
      font-size: 0.77rem;
      color: var(--text-muted);
      margin-top: 8px;
      display: flex;
      align-items: flex-start;
      gap: 6px;
      line-height: 1.5;
    }

    /* Analyze Button */
    .btn-analyze {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--gold) 0%, #a07830 100%);
      color: #0d0e12;
      border: none;
      border-radius: var(--radius-md);
      font: 600 1rem 'DM Sans', sans-serif;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      transition: var(--transition);
      position: relative;
      overflow: hidden;
    }

    .btn-analyze::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, #e2cd96 0%, var(--gold) 100%);
      opacity: 0;
      transition: opacity 0.3s;
    }

    .btn-analyze:hover:not(:disabled)::before {
      opacity: 1;
    }

    .btn-analyze:hover:not(:disabled) {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px var(--gold-glow);
    }

    .btn-analyze:disabled {
      background: var(--bg-input);
      color: var(--text-muted);
      cursor: not-allowed;
    }

    .btn-analyze span,
    .btn-analyze i {
      position: relative;
    }

    /* ═══ COMPARE PANEL ═══ */
    .compare-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    .compare-drop {
      border: 2px dashed var(--border);
      border-radius: var(--radius-md);
      padding: 1.5rem;
      text-align: center;
      cursor: pointer;
      transition: var(--transition);
    }

    .compare-drop:hover,
    .compare-drop.drag-over {
      border-color: var(--gold);
      background: var(--gold-dim);
    }

    .compare-drop i {
      font-size: 1.8rem;
      color: var(--gold);
      margin-bottom: 8px;
      display: block;
    }

    .compare-drop p {
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .compare-drop .file-badge {
      display: inline-block;
      margin-top: 8px;
      padding: 3px 10px;
      border-radius: 99px;
      background: rgba(74, 222, 128, 0.1);
      border: 1px solid rgba(74, 222, 128, 0.3);
      color: var(--green);
      font-size: 0.75rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .compare-result {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 1rem;
      align-items: center;
      margin-top: 1.5rem;
    }

    .compare-cv {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1.25rem;
    }

    .compare-cv h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
      color: var(--text-primary);
    }

    .compare-score {
      text-align: center;
    }

    .compare-score .big-score {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2.5rem;
      font-weight: 700;
    }

    .compare-score .score-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .compare-vs {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--text-muted);
      text-align: center;
    }

    .winner-badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 99px;
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(200, 170, 100, 0.15);
      color: var(--gold);
      border: 1px solid rgba(200, 170, 100, 0.3);
      margin-top: 6px;
    }

    /* ═══ HISTORY PANEL ═══ */
    .history-overlay {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: rgba(4, 5, 10, 0.7);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: flex-start;
      justify-content: flex-end;
    }

    .history-drawer {
      width: min(420px, 95vw);
      height: 100vh;
      background: var(--bg-card);
      border-left: 1px solid var(--border);
      padding: 1.5rem;
      overflow-y: auto;
      animation: slideIn 0.3s ease;
    }

    @keyframes slideIn {
      from {
        transform: translateX(100%);
      }

      to {
        transform: translateX(0);
      }
    }

    .history-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid var(--border);
    }

    .history-header h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
    }

    .close-btn {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-secondary);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: var(--transition);
    }

    .close-btn:hover {
      border-color: var(--red);
      color: var(--red);
    }

    .history-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .history-item {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem;
      cursor: pointer;
      transition: var(--transition);
    }

    .history-item:hover {
      border-color: var(--gold);
      transform: translateX(-3px);
    }

    .h-name {
      font-weight: 600;
      font-size: 0.95rem;
      margin-bottom: 4px;
    }

    .h-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .h-score {
      font-family: 'Cormorant Garamond', serif;
      font-weight: 700;
      color: var(--gold);
    }

    .h-date {
      font-size: 0.75rem;
      color: var(--text-muted);
    }

    .h-level {
      font-size: 0.7rem;
      padding: 2px 8px;
      border-radius: 99px;
      background: var(--gold-dim);
      color: var(--gold);
      border: 1px solid rgba(200, 170, 100, 0.25);
    }

    .history-empty {
      text-align: center;
      color: var(--text-muted);
      padding: 2rem;
      font-size: 0.9rem;
    }

    /* ═══ LOADING ═══ */
    .loading-overlay {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: rgba(13, 14, 18, 0.85);
      backdrop-filter: blur(10px);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    [data-theme="light"] .loading-overlay {
      background: rgba(245, 243, 238, 0.85);
    }

    .loading-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 32px;
      padding: 2.5rem 3rem;
      text-align: center;
      box-shadow: var(--shadow-card);
      animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
    }

    @keyframes popIn {
      from {
        opacity: 0;
        transform: scale(0.85);
      }

      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .loader-rings {
      position: relative;
      width: 80px;
      height: 80px;
      margin: 0 auto 1.5rem;
    }

    .ring {
      position: absolute;
      border-radius: 50%;
      border: 2px solid transparent;
    }

    .ring-1 {
      inset: 0;
      border-top-color: var(--gold);
      animation: spin 1.2s linear infinite;
    }

    .ring-2 {
      inset: 10px;
      border-right-color: rgba(200, 170, 100, 0.5);
      animation: spin 0.9s linear infinite reverse;
    }

    .ring-3 {
      inset: 20px;
      border-bottom-color: rgba(200, 170, 100, 0.25);
      animation: spin 1.6s linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    .loader-center-icon {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      font-size: 1.1rem;
      color: var(--gold);
    }

    .loading-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      font-weight: 600;
      margin-bottom: 1.2rem;
    }

    .loading-steps {
      text-align: left;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .step {
      font-size: 0.85rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 8px;
      transition: color 0.3s;
    }

    .step i {
      font-size: 0.7rem;
    }

    .step.active {
      color: var(--text-primary);
    }

    .step.done {
      color: var(--green);
    }

    /* ═══ RESULTS ═══ */
    .results {
      animation: fadeUp 0.5s ease both;
    }

    .identity-bar {
      display: flex;
      align-items: center;
      gap: 1rem;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: var(--shadow-card);
      flex-wrap: wrap;
    }

    .avatar {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--gold) 0%, #6b4e12 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.4rem;
      font-weight: 700;
      color: #0d0e12;
      flex-shrink: 0;
    }

    .identity-info {
      flex: 1;
      min-width: 0;
    }

    .candidate-name {
      font-size: clamp(1.3rem, 3vw, 1.8rem);
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .identity-meta {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 4px;
      flex-wrap: wrap;
    }

    .badge {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: 99px;
    }

    .badge-exp {
      background: var(--gold-dim);
      color: var(--gold);
      border: 1px solid rgba(200, 170, 100, 0.3);
    }

    .identity-edu {
      font-size: 0.85rem;
      color: var(--text-secondary);
      font-weight: 300;
    }

    .result-actions {
      display: flex;
      gap: 8px;
      margin-left: auto;
      flex-wrap: wrap;
    }

    .btn-reset,
    .btn-export {
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      font: 500 0.82rem 'DM Sans', sans-serif;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 7px;
      transition: var(--transition);
      white-space: nowrap;
    }

    .btn-reset {
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-secondary);
    }

    .btn-reset:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .btn-export {
      background: var(--gold-dim);
      border: 1px solid rgba(200, 170, 100, 0.3);
      color: var(--gold);
    }

    .btn-export:hover {
      background: rgba(200, 170, 100, 0.25);
      box-shadow: 0 4px 20px var(--gold-glow);
    }

    /* Scores */
    .scores-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .score-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem 1rem;
      text-align: center;
      box-shadow: var(--shadow-card);
      transition: var(--transition);
    }

    .score-card:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card), var(--shadow-glow);
    }

    .score-label {
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-secondary);
      margin-bottom: 1rem;
    }

    .score-sublabel {
      font-size: 0.8rem;
      color: var(--text-secondary);
      margin-top: 0.75rem;
      font-weight: 500;
    }

    .circular-chart-wrap {
      width: 110px;
      margin: 0 auto;
    }

    .circular-chart {
      display: block;
    }

    .circle-bg {
      fill: none;
      stroke: var(--bg-input);
      stroke-width: 3.2;
    }

    .circle-fill {
      fill: none;
      stroke: var(--gold);
      stroke-width: 3.2;
      stroke-linecap: round;
      transform-origin: center;
      transform: rotate(-90deg);
      transition: stroke-dasharray 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .circle-fill-match {
      stroke: #60a5fa;
    }

    .percentage {
      fill: var(--text-primary);
      font-family: 'Cormorant Garamond', serif;
      font-size: 7px;
      font-weight: 700;
      text-anchor: middle;
    }

    .score-bar-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 1.5rem;
      box-shadow: var(--shadow-card);
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .score-bar-card:hover {
      border-color: var(--border-hover);
      box-shadow: var(--shadow-card), var(--shadow-glow);
    }

    .score-bar-card .score-label {
      margin-bottom: 1rem;
    }

    .ats-bar-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 6px;
    }

    .ats-bar-track {
      flex: 1;
      height: 8px;
      background: var(--bg-input);
      border-radius: 99px;
      overflow: hidden;
    }

    .ats-bar-fill {
      height: 100%;
      width: 0%;
      border-radius: 99px;
      background: linear-gradient(90deg, #c8aa64, #e2cd96);
      transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ats-bar-pct {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      font-weight: 700;
      color: var(--gold);
      min-width: 42px;
      text-align: right;
    }

    .ats-bar-labels {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    /* Detailed Score */
    .detailed-scores {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 8px;
      margin-bottom: 1.5rem;
    }

    .detail-score-item {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 1rem;
      text-align: center;
      transition: var(--transition);
    }

    .detail-score-item:hover {
      border-color: var(--border-hover);
    }

    .ds-label {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .ds-bar {
      height: 4px;
      background: var(--bg-card);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 6px;
    }

    .ds-fill {
      height: 100%;
      border-radius: 99px;
      background: linear-gradient(90deg, var(--gold), var(--gold-light));
      width: 0%;
      transition: width 1.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .ds-value {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--gold);
    }

    /* Skills */
    .result-card {
      margin-bottom: 1rem;
    }

    .skills-cloud {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .skill-tag {
      padding: 5px 13px;
      border-radius: 99px;
      font-size: 0.8rem;
      font-weight: 500;
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-secondary);
      cursor: default;
      transition: var(--transition);
      animation: fadeUp 0.3s ease both;
    }

    .skill-tag:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: var(--gold-dim);
      transform: translateY(-2px);
    }

    /* Insight cards */
    .swipe-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1rem;
      margin-bottom: 1.5rem;
    }

    .insight-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .insight-item {
      display: flex;
      gap: 10px;
      align-items: flex-start;
      font-size: 0.9rem;
      line-height: 1.55;
      color: var(--text-secondary);
      font-weight: 300;
      padding: 10px 12px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--bg-input);
      transition: var(--transition);
      animation: fadeUp 0.4s ease both;
    }

    .insight-item:hover {
      border-color: var(--border-hover);
      color: var(--text-primary);
      transform: translateX(3px);
    }

    .insight-bullet {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      flex-shrink: 0;
      margin-top: 1px;
    }

    .bullet-green {
      background: rgba(74, 222, 128, 0.15);
      color: var(--green);
    }

    .bullet-amber {
      background: rgba(251, 146, 60, 0.15);
      color: var(--amber);
    }

    .bullet-gold {
      background: var(--gold-dim);
      color: var(--gold);
    }

    /* Footer */
    .footer {
      text-align: center;
      padding: 2rem;
      font-size: 0.78rem;
      color: var(--text-muted);
      border-top: 1px solid var(--border);
    }

    /* Utilities */
    .hidden {
      display: none !important;
    }

    .mt {
      margin-top: 1.5rem;
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.2rem;
      font-weight: 600;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .section-title i {
      color: var(--gold);
      font-size: 1rem;
    }

    /* Responsive */
    @media(max-width:640px) {
      .scores-row {
        grid-template-columns: 1fr 1fr;
      }

      .score-bar-card {
        grid-column: 1/-1;
      }

      .swipe-grid {
        grid-template-columns: 1fr;
      }

      .compare-grid {
        grid-template-columns: 1fr;
      }

      .compare-result {
        grid-template-columns: 1fr;
        text-align: center;
      }

      .compare-vs {
        display: none;
      }

      .loading-card {
        padding: 2rem 1.5rem;
        margin: 1rem;
      }

      .result-actions {
        margin-left: 0;
        width: 100%;
      }

      .detailed-scores {
        grid-template-columns: 1fr 1fr;
      }
    }

    @media(max-width:380px) {
      .scores-row {
        grid-template-columns: 1fr;
      }
    }
  
    /* ── AUTH (login / register) ── */
    .auth-overlay { position: fixed; inset: 0; background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center; z-index: 1000; padding: 16px; }
    .auth-overlay.hidden { display: none; }
    .auth-modal { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 28px; width: 100%; max-width: 380px; box-shadow: var(--shadow-card); position: relative; }
    .auth-modal h3 { font-size: 1.25rem; margin-bottom: 4px; color: var(--text-primary); }
    .auth-modal .auth-sub { color: var(--text-secondary); font-size: .85rem; margin-bottom: 18px; }
    .auth-close { position: absolute; top: 14px; right: 14px; background: none; border: none; color: var(--text-secondary); font-size: 1.1rem; cursor: pointer; }
    .auth-field { width: 100%; padding: 11px 14px; margin-bottom: 10px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font-size: .92rem; font-family: inherit; outline: none; }
    .auth-field:focus { border-color: var(--border-hover); }
    .auth-submit { width: 100%; padding: 12px; border: none; border-radius: 10px; background: var(--gold); color: #1a1712; font-weight: 600; font-size: .95rem; cursor: pointer; font-family: inherit; }
    .auth-submit:disabled { opacity: .6; cursor: wait; }
    .auth-error { color: var(--red); font-size: .82rem; min-height: 18px; margin-bottom: 8px; }
    .auth-switch { text-align: center; margin-top: 14px; font-size: .85rem; color: var(--text-secondary); }
    .auth-switch button { background: none; border: none; color: var(--gold); cursor: pointer; font-family: inherit; font-size: inherit; }
    .user-chip { display: inline-flex; align-items: center; gap: 8px; }
    .user-chip.hidden, .nav-history-btn.hidden { display: none; }
    .user-chip .user-name { font-size: .85rem; color: var(--text-secondary); max-width: 110px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .h-delete { background: none; border: none; color: var(--text-muted); cursor: pointer; margin-left: auto; padding: 4px 6px; }
    .h-delete:hover { color: var(--red); }
    .history-item .h-top { display: flex; align-items: center; gap: 8px; }
  
    /* ── RANKING ── */
    .rank-files { display: flex; flex-direction: column; gap: 8px; margin: 12px 0 4px; }
    .rank-file { display: flex; align-items: center; gap: 10px; padding: 8px 12px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; font-size: .85rem; color: var(--text-secondary); }
    .rank-file i { color: var(--gold); }
    .rank-file span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rank-file button { background: none; border: none; color: var(--text-muted); cursor: pointer; }
    .rank-file button:hover { color: var(--red); }
    .rank-label { display: block; margin: 16px 0 6px; font-size: .88rem; color: var(--text-primary); font-weight: 500; }
    .rank-label span { color: var(--text-muted); font-weight: 400; }
    .rank-jd { width: 100%; padding: 12px 14px; margin-bottom: 14px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font-family: inherit; font-size: .9rem; resize: vertical; outline: none; }
    .rank-jd:focus { border-color: var(--border-hover); }
    .rank-results { margin-top: 22px; display: flex; flex-direction: column; gap: 14px; }
    .rank-results.hidden { display: none; }
    .rank-card { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
    .rank-card.rank-top { border-color: var(--gold); box-shadow: 0 0 0 1px var(--gold-dim); }
    .rank-card.rank-fail { border-color: var(--red); }
    .rank-head { display: flex; align-items: center; gap: 12px; }
    .rank-pos { font-size: 1.5rem; min-width: 38px; text-align: center; color: var(--gold); font-weight: 700; }
    .rank-id { flex: 1; min-width: 0; }
    .rank-id h4 { font-size: 1rem; color: var(--text-primary); margin: 0; }
    .rank-sub { font-size: .78rem; color: var(--text-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .rank-match { text-align: center; }
    .rank-match-num { display: block; font-size: 1.6rem; font-weight: 700; color: var(--gold); line-height: 1; }
    .rank-match small { font-size: .7rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
    .rank-bar { height: 6px; background: var(--bg-input); border-radius: 99px; margin: 12px 0 8px; overflow: hidden; }
    .rank-bar-fill { height: 100%; background: var(--gold); border-radius: 99px; transition: width .8s ease; }
    .rank-ats { font-size: .8rem; color: var(--text-secondary); margin-bottom: 8px; }
    .rank-badge { display: inline-block; margin-left: 8px; padding: 2px 8px; border-radius: 99px; background: var(--gold-dim); color: var(--gold); font-size: .7rem; font-weight: 600; }
    .rank-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .rank-chip { padding: 3px 9px; border-radius: 99px; font-size: .75rem; border: 1px solid; }
    .rank-chip.ok { color: var(--green); border-color: var(--green); }
    .rank-chip.miss { color: var(--red); border-color: var(--red); }
    .rank-note { font-size: .8rem; color: var(--text-secondary); margin-top: 10px; line-height: 1.5; }
    .rank-note b { color: var(--text-primary); }
    .rank-view-btn { margin-top: 12px; padding: 8px 14px; border-radius: var(--radius-sm); border: 1px solid rgba(200, 170, 100, 0.3); background: var(--gold-dim); color: var(--gold); font: 500 .8rem 'DM Sans', sans-serif; cursor: pointer; display: inline-flex; align-items: center; gap: 7px; transition: var(--transition); }
    .rank-view-btn:hover { background: rgba(200, 170, 100, 0.25); box-shadow: 0 4px 20px var(--gold-glow); }
  </style>

  <style>
    .lang-row { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; font-size: .88rem; color: var(--text-secondary); }
    .lang-row i { color: var(--gold); }
    .lang-select { padding: 8px 12px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font: inherit; outline: none; cursor: pointer; }
    .lang-select:focus { border-color: var(--border-hover); }
    .rw-modal { position: relative; background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 24px; width: 100%; max-width: 760px; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow-card); }
    .rw-modal h3 { font-size: 1.4rem; margin-bottom: 12px; padding-right: 30px; }
    .rw-h { font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); margin: 14px 0 6px; }
    .rw-list { margin: 0 0 6px 18px; font-size: .85rem; color: var(--text-secondary); line-height: 1.6; }
    .rw-text { white-space: pre-wrap; word-break: break-word; margin: 14px 0; padding: 16px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 12px; font: .88rem/1.65 'DM Sans', sans-serif; color: var(--text-primary); max-height: 45vh; overflow-y: auto; }
    .rw-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  </style>

  <style>
    .dash-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-bottom: 20px; }
    .dash-stat { background: var(--bg-input); border: 1px solid var(--border); border-radius: 14px; padding: 16px; text-align: center; }
    .dash-stat b { display: block; font-family: 'Cormorant Garamond', serif; font-size: 2rem; color: var(--gold); line-height: 1.1; }
    .dash-stat span { font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-muted); }
    .dash-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px; }
    @media (max-width: 640px) { .dash-grid { grid-template-columns: 1fr; } }
    .dash-box { background: var(--bg-input); border: 1px solid var(--border); border-radius: 14px; padding: 16px; }
    .dash-box h4 { font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--gold); margin-bottom: 12px; }
    .dash-bar-row { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--text-secondary); margin-bottom: 8px; }
    .dash-bar-row .lbl { width: 96px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dash-bar-track { flex: 1; height: 8px; background: var(--bg-card); border-radius: 99px; overflow: hidden; }
    .dash-bar-fill { height: 100%; background: var(--gold); border-radius: 99px; }
    .dash-filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .dash-filters input, .dash-filters select { padding: 9px 12px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font: inherit; font-size: .85rem; outline: none; }
    .dash-filters input { flex: 1; min-width: 160px; }
    .dash-filters input:focus, .dash-filters select:focus { border-color: var(--border-hover); }
    .dash-row { display: grid; grid-template-columns: 1fr auto auto auto; gap: 14px; align-items: center; padding: 12px 14px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; margin-bottom: 8px; }
    .dash-name { font-weight: 600; font-size: .95rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dash-sub { font-size: .75rem; color: var(--text-muted); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dash-num { text-align: center; min-width: 44px; }
    .dash-num b { display: block; font-family: 'Cormorant Garamond', serif; font-size: 1.3rem; color: var(--gold); line-height: 1; }
    .dash-num small { font-size: .62rem; text-transform: uppercase; letter-spacing: .06em; color: var(--text-muted); }
    @media (max-width: 640px) { .dash-row { grid-template-columns: 1fr auto auto; } .dash-row .rank-view-btn { grid-column: 1 / -1; justify-content: center; } }
  </style>

  <style>
    .pw-rules { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 12px; margin: -2px 0 12px; font-size: .75rem; color: var(--text-muted); }
    .pw-rules li.ok { color: var(--green); }
    #authVerify { text-align: center; margin-bottom: 8px; }
    .auth-code { text-align: center; letter-spacing: .5em; font-size: 1.4rem; font-weight: 600; }
    #authResend:disabled { opacity: .6; cursor: default; text-decoration: none; }
  </style>

  <style>
    .btn-danger { width: 100%; padding: 11px; border: 1px solid var(--red); border-radius: 10px; background: rgba(248, 113, 113, .1); color: var(--red); font: 600 .9rem 'DM Sans', sans-serif; cursor: pointer; }
    .btn-danger:hover { background: rgba(248, 113, 113, .2); }
    .btn-danger:disabled { opacity: .6; cursor: wait; }
    .acc-note { font-size: .82rem; color: var(--text-secondary); margin-bottom: 12px; line-height: 1.5; }
    #userName { cursor: pointer; }
    #userName:hover { color: var(--gold); }
    .ba-box { background: var(--bg-input); border: 1px solid var(--border); border-radius: 12px; padding: 4px 16px 10px; margin-bottom: 8px; }
    .ba-row { display: flex; align-items: center; gap: 10px; font-size: .95rem; margin: 6px 0; }
    .ba-row span { min-width: 90px; color: var(--text-secondary); }
    .ba-row b { font-family: 'Cormorant Garamond', serif; font-size: 1.4rem; }
    .ba-row b.up { color: var(--green); }
    .ba-row b.down { color: var(--red); }
    .ba-row small { color: var(--text-muted); }
  </style>

  <style>
    .jobs-bar { display: flex; gap: 6px; flex-wrap: wrap; margin: 0 0 8px; }
    .jobs-select { flex: 1; min-width: 140px; padding: 8px 10px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font: inherit; font-size: .82rem; outline: none; }
    .jobs-btn { padding: 8px 12px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-card); color: var(--text-secondary); font: 500 .8rem 'DM Sans', sans-serif; cursor: pointer; }
    .jobs-btn:hover { border-color: var(--gold); color: var(--gold); }
    .pipe-strip { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 12px; }
    .pipe-chip { padding: 4px 12px; border-radius: 99px; font-size: .78rem; border: 1px solid var(--border); background: var(--bg-input); color: var(--text-secondary); }
    .pipe-chip b { color: var(--text-primary); margin-left: 4px; }
    .dash-pipe { grid-column: 1 / -1; display: flex; gap: 8px; }
    .pipe-status { padding: 7px 10px; border-radius: 10px; border: 1px solid var(--border); background: var(--bg-input); color: var(--text-primary); font: inherit; font-size: .8rem; outline: none; }
    .pipe-note { flex: 1; min-width: 0; padding: 7px 10px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font: inherit; font-size: .82rem; outline: none; }
    .pipe-note:focus, .pipe-status:focus { border-color: var(--border-hover); }
    .st-shortlisted { color: var(--green) !important; border-color: var(--green) !important; }
    .st-interview { color: var(--blue) !important; border-color: var(--blue) !important; }
    .st-rejected { color: var(--red) !important; border-color: var(--red) !important; }
  </style>

  <!-- Vercel Analytics -->
  <script>
    window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };
  </script>
  <script defer src="/_vercel/insights/script.js"></script>
</head>

<body>

  <!-- NAVBAR -->
  <nav class="navbar">
    <div class="nav-brand">
      <span class="brand-icon"><i class="fa-solid fa-scroll"></i></span>
      <span class="brand-name">CV<em>ision</em></span>
    </div>
    <div class="nav-right">
      <button class="nav-history-btn" id="historyBtn">
        <i class="fa-solid fa-clock-rotate-left"></i> History
      </button>
      <button class="nav-history-btn" id="authBtn">
        <i class="fa-solid fa-user"></i> Login
      </button>
      <div class="user-chip hidden" id="userChip">
        <span class="user-name" id="userName"></span>
        <button class="nav-history-btn" id="logoutBtn" title="Logout">
          <i class="fa-solid fa-right-from-bracket"></i>
        </button>
      </div>
      <button class="theme-toggle" id="themeToggle">
        <i class="fa-solid fa-moon" id="themeIcon"></i>
      </button>
    </div>
  </nav>

  <!-- HERO -->
  <header class="hero">
    <div class="hero-bg-orb orb-1"></div>
    <div class="hero-bg-orb orb-2"></div>
    <div class="hero-content">
      <p class="hero-eyebrow">AI-Powered Recruitment Intelligence</p>
      <h1 class="hero-title">Decode Every<br /><em>CV in Seconds</em></h1>
      <p class="hero-subtitle">Upload a résumé and receive an instant, structured analysis — skills mapping, ATS
        scoring, strengths and actionable improvements.</p>
    </div>
  </header>

  <!-- MAIN -->
  <main class="container">

    <!-- TABS -->
    <div class="main-tabs">
      <button class="tab-btn active" data-tab="upload">
        <i class="fa-solid fa-cloud-arrow-up"></i> Analyze CV
      </button>
      <button class="tab-btn" data-tab="compare">
        <i class="fa-solid fa-ranking-star"></i> Rank Candidates
      </button>
    </div>

    <!-- TAB: UPLOAD -->
    <div class="tab-panel active" id="tab-upload">
      <section class="card upload-card" id="uploadSection">
        <div class="card-header">
          <i class="fa-solid fa-cloud-arrow-up card-header-icon"></i>
          <h2>Upload CV</h2>
        </div>
        <div class="drop-zone" id="dropZone">
          <input type="file" id="fileInput" accept=".pdf,.docx" hidden />
          <div class="drop-zone-inner" id="dropZoneInner">
            <div class="drop-icon-wrap"><i class="fa-regular fa-file-lines drop-icon"></i></div>
            <p class="drop-primary">Drag &amp; drop your CV here</p>
            <p class="drop-secondary">or <button class="inline-btn" id="browseBtn">browse files</button></p>
            <p class="drop-formats">PDF · DOCX &nbsp;·&nbsp; Max 16 MB</p>
          </div>
          <div class="file-selected hidden" id="fileSelected">
            <i class="fa-regular fa-circle-check file-check-icon"></i>
            <div class="file-info">
              <span class="file-name" id="fileName"></span>
              <span class="file-size" id="fileSize"></span>
            </div>
            <button class="remove-file" id="removeFile"><i class="fa-solid fa-xmark"></i></button>
          </div>
        </div>

        <div class="jd-section">
          <button class="jd-toggle" id="jdToggle">
            <i class="fa-solid fa-briefcase"></i>
            Paste Job Description <span class="badge-optional">optional</span>
            <i class="fa-solid fa-chevron-down jd-chevron" id="jdChevron"></i>
          </button>
          <div class="jd-body hidden" id="jdBody">
            <div class="jobs-bar hidden" data-target="jobDescription">
              <select class="jobs-select"><option value="">Saved job offers…</option></select>
              <button type="button" class="jobs-btn jobs-load">Load</button>
              <button type="button" class="jobs-btn jobs-save">Save current</button>
              <button type="button" class="jobs-btn jobs-del" title="Delete the selected offer"><i class="fa-solid fa-trash"></i></button>
            </div>
            <textarea id="jobDescription" rows="6"
              placeholder="Paste the job description here to get a match score…"></textarea>
            <p class="jd-hint"><i class="fa-solid fa-circle-info"></i> Our AI matches your skills and computes your
              compatibility score instantly.</p>
          </div>
        </div>

        <div class="lang-row"><i class="fa-solid fa-language"></i><label for="langSelect">Report language</label>
          <select id="langSelect" class="lang-select"><option value="en">English</option><option value="fr">Français</option><option value="ar">العربية</option></select></div>
        <button class="btn-analyze" id="analyzeBtn" disabled>
          <i class="fa-solid fa-magnifying-glass-chart"></i> Analyze CV
        </button>
      </section>
    </div>

    <!-- TAB: COMPARE -->
    <div class="tab-panel" id="tab-compare">
      <div class="card">
        <div class="card-header">
          <i class="fa-solid fa-ranking-star card-header-icon"></i>
          <h2>Rank Candidates for a Job</h2>
        </div>
        <div class="compare-drop" id="rankDrop">
          <input type="file" id="rankFiles" accept=".pdf,.docx" multiple hidden />
          <i class="fa-solid fa-cloud-arrow-up"></i>
          <p>Drop 2 to 5 CVs here or click to browse</p>
        </div>
        <div class="rank-files" id="rankFileList"></div>
        <div class="jobs-bar hidden" data-target="rankJD">
          <select class="jobs-select"><option value="">Saved job offers…</option></select>
          <button type="button" class="jobs-btn jobs-load">Load</button>
          <button type="button" class="jobs-btn jobs-save">Save current</button>
          <button type="button" class="jobs-btn jobs-del" title="Delete the selected offer"><i class="fa-solid fa-trash"></i></button>
        </div>
        <label class="rank-label" for="rankJD">Job description <span>(required)</span></label>
        <textarea class="rank-jd" id="rankJD" rows="6"
          placeholder="Paste the job description here: required skills, experience, responsibilities…"></textarea>
        <div class="lang-row"><i class="fa-solid fa-language"></i><label for="rankLang">Report language</label>
          <select id="rankLang" class="lang-select"><option value="en">English</option><option value="fr">Français</option><option value="ar">العربية</option></select></div>
        <button class="btn-analyze" id="rankBtn" disabled>
          <i class="fa-solid fa-ranking-star"></i> Rank candidates
        </button>
        <div class="rank-results hidden" id="rankResults"></div>
      </div>
    </div>

    <!-- TAB: DASHBOARD (recruiters) -->
    <div class="tab-panel" id="tab-dashboard">
      <div class="card">
        <div class="card-header">
          <i class="fa-solid fa-chart-pie card-header-icon"></i>
          <h2>Recruiter Dashboard</h2>
        </div>
        <div id="dashBody"></div>
      </div>
    </div>

    <!-- LOADING -->
    <div class="loading-overlay hidden" id="loadingOverlay">
      <div class="loading-card">
        <div class="loader-rings">
          <div class="ring ring-1"></div>
          <div class="ring ring-2"></div>
          <div class="ring ring-3"></div>
          <i class="fa-solid fa-scroll loader-center-icon"></i>
        </div>
        <p class="loading-title">Analyzing CV…</p>
        <div class="loading-steps" id="loadingSteps">
          <p class="step active"><i class="fa-solid fa-check-circle"></i> Parsing document</p>
          <p class="step"><i class="fa-solid fa-check-circle"></i> Extracting skills &amp; experience</p>
          <p class="step"><i class="fa-solid fa-check-circle"></i> Calculating ATS score</p>
          <p class="step"><i class="fa-solid fa-check-circle"></i> Generating insights</p>
        </div>
      </div>
    </div>

    <!-- RESULTS -->
    <section class="results hidden" id="resultsSection">

      <!-- Identity -->
      <div class="identity-bar">
        <div class="avatar" id="avatarInitials"></div>
        <div class="identity-info">
          <h2 class="candidate-name" id="candidateName"></h2>
          <div class="identity-meta">
            <span class="badge badge-exp" id="expLevel"></span>
            <span class="identity-edu" id="educationText"></span>
          </div>
        </div>
        <div class="result-actions">
          <button class="btn-reset hidden" id="backRankBtn">
            <i class="fa-solid fa-arrow-left"></i> Back to ranking
          </button>
          <button class="btn-reset hidden" id="backDashBtn"><i class="fa-solid fa-arrow-left"></i> Back to dashboard</button>
          <button class="btn-export hidden" id="rewriteBtn"><i class="fa-solid fa-wand-magic-sparkles"></i> Improve my CV</button>
          <button class="btn-export" id="exportBtn">
            <i class="fa-solid fa-file-pdf"></i> Export PDF
          </button>
          <button class="btn-reset" id="resetBtn">
            <i class="fa-solid fa-rotate-left"></i> New
          </button>
        </div>
      </div>

      <!-- Scores -->
      <div class="scores-row">
        <div class="score-card">
          <p class="score-label">ATS Score</p>
          <div class="circular-chart-wrap">
            <svg class="circular-chart" viewBox="0 0 36 36">
              <path class="circle-bg"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path class="circle-fill" id="atsFill" stroke-dasharray="0,100"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <text x="18" y="20.35" class="percentage" id="atsScoreText">0</text>
            </svg>
          </div>
          <p class="score-sublabel" id="atsRating"></p>
        </div>

        <div class="score-card hidden" id="matchScoreCard">
          <p class="score-label">Job Match</p>
          <div class="circular-chart-wrap">
            <svg class="circular-chart" viewBox="0 0 36 36">
              <path class="circle-bg"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <path class="circle-fill circle-fill-match" id="matchFill" stroke-dasharray="0,100"
                d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831" />
              <text x="18" y="20.35" class="percentage" id="matchScoreText">0</text>
            </svg>
          </div>
          <p class="score-sublabel" id="matchRating"></p>
        </div>

        <div class="score-bar-card">
          <p class="score-label">ATS Compatibility</p>
          <div class="ats-bar-wrap">
            <div class="ats-bar-track">
              <div class="ats-bar-fill" id="atsBarFill"></div>
            </div>
            <span class="ats-bar-pct" id="atsBarPct">0%</span>
          </div>
          <div class="ats-bar-labels"><span>Poor</span><span>Average</span><span>Excellent</span></div>
        </div>
      </div>

      <!-- Detailed Score Breakdown -->
      <p class="section-title"><i class="fa-solid fa-chart-bar"></i> Score Breakdown</p>
      <div class="detailed-scores" id="detailedScores"></div>

      <!-- Skills -->
      <div class="card result-card">
        <div class="card-header">
          <i class="fa-solid fa-microchip card-header-icon"></i>
          <h3>Detected Skills</h3>
        </div>
        <div class="skills-cloud" id="skillsCloud"></div>
      </div>

      <!-- Strengths / Weaknesses / Suggestions -->
      <div class="swipe-grid">
        <div class="card result-card">
          <div class="card-header">
            <i class="fa-solid fa-circle-check card-header-icon icon-green"></i>
            <h3>Strengths</h3>
          </div>
          <ul class="insight-list" id="strengthsList"></ul>
        </div>
        <div class="card result-card">
          <div class="card-header">
            <i class="fa-solid fa-triangle-exclamation card-header-icon icon-amber"></i>
            <h3>Areas to Address</h3>
          </div>
          <ul class="insight-list" id="weaknessesList"></ul>
        </div>
        <div class="card result-card">
          <div class="card-header">
            <i class="fa-solid fa-lightbulb card-header-icon icon-gold"></i>
            <h3>Suggestions</h3>
          </div>
          <ul class="insight-list" id="suggestionsList"></ul>
        </div>
      </div>

    </section>

  </main>

  <!-- REWRITE MODAL -->
  <div class="auth-overlay hidden" id="rwOverlay">
    <div class="rw-modal">
      <button class="auth-close" id="rwClose"><i class="fa-solid fa-xmark"></i></button>
      <h3>Your improved CV</h3>
      <div id="rwNotes"></div>
      <pre class="rw-text" id="rwText" dir="auto"></pre>
      <div class="rw-actions">
        <button class="btn-export" id="rwCopy"><i class="fa-regular fa-copy"></i> Copy</button>
        <button class="btn-export" id="rwDownload"><i class="fa-solid fa-download"></i> Download .txt</button>
        <button class="btn-export" id="rwPrint"><i class="fa-solid fa-file-pdf"></i> Print / PDF</button>
      </div>
    </div>
  </div>

  <!-- ACCOUNT MODAL -->
  <div class="auth-overlay hidden" id="accOverlay">
    <div class="rw-modal" style="max-width:440px">
      <button class="auth-close" id="accClose"><i class="fa-solid fa-xmark"></i></button>
      <h3>My account</h3>
      <p class="acc-note" id="accInfo"></p>
      <p class="rw-h">Change password</p>
      <input class="auth-field" id="accCurrent" type="password" placeholder="Current password" autocomplete="current-password" />
      <input class="auth-field" id="accNew" type="password" placeholder="New password" autocomplete="new-password" />
      <ul class="pw-rules" id="accRules"></ul>
      <div class="auth-error" id="accMsg"></div>
      <button class="auth-submit" id="accChange">Change password</button>
      <p class="rw-h" style="margin-top:24px;color:var(--red)">Danger zone</p>
      <p class="acc-note">This permanently deletes your account, your saved analyses and the stored CV texts.</p>
      <input class="auth-field" id="accDelPw" type="password" placeholder="Your password" autocomplete="current-password" />
      <div class="auth-error" id="accDelMsg"></div>
      <button class="btn-danger" id="accDelete">Delete my account</button>
    </div>
  </div>

  <!-- AUTH MODAL -->
  <div class="auth-overlay hidden" id="authOverlay">
    <div class="auth-modal">
      <button class="auth-close" id="authClose"><i class="fa-solid fa-xmark"></i></button>
      <h3 id="authTitle">Login</h3>
      <p class="auth-sub">Save your analyses and access them from any device.</p>
      <input class="auth-field hidden" id="authName" type="text" placeholder="Full name" autocomplete="name" />
      <select class="auth-field hidden" id="authRole"><option value="candidate">I am a candidate</option><option value="recruiter">I am a recruiter</option></select>
      <input class="auth-field" id="authEmail" type="email" placeholder="Email" autocomplete="email" />
      <input class="auth-field" id="authPassword" type="password" placeholder="Password" autocomplete="current-password" />
      <ul class="pw-rules hidden" id="pwRules"></ul>
      <div class="hidden" id="authVerify">
        <input class="auth-field auth-code" id="authCode" type="text" inputmode="numeric" maxlength="6" placeholder="••••••" autocomplete="one-time-code" />
        <button type="button" class="inline-btn" id="authResend">Resend code</button>
      </div>
      <div style="text-align:right;margin:-4px 0 8px"><button type="button" class="inline-btn" id="authForgot" style="font-size:.8rem">Forgot password?</button></div>
      <div class="auth-error" id="authError"></div>
      <button class="auth-submit" id="authSubmit">Login</button>
      <div class="auth-switch"><span id="authSwitchText">No account?</span> <button id="authSwitchBtn">Register</button></div>
    </div>
  </div>

  <!-- HISTORY DRAWER -->
  <div class="history-overlay hidden" id="historyOverlay">
    <div class="history-drawer">
      <div class="history-header">
        <h3>Analysis History</h3>
        <button class="close-btn" id="closeHistory"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="history-list" id="historyList"></div>
    </div>
  </div>

  <footer class="footer">
    <p>CVision &nbsp;·&nbsp; Powered by Moroccan hands &nbsp;·&nbsp; <span id="year"></span></p>
  </footer>

  <script>
    /* ══════════════════════════════════════
       THEME
    ══════════════════════════════════════ */
    const html = document.documentElement;
    const saved = localStorage.getItem('cvision-theme') || 'dark';
    html.setAttribute('data-theme', saved);
    syncIcon(saved);
    document.getElementById('themeToggle').addEventListener('click', () => {
      const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('cvision-theme', next);
      syncIcon(next);
    });
    function syncIcon(t) { document.getElementById('themeIcon').className = t === 'dark' ? 'fa-solid fa-moon' : 'fa-solid fa-sun'; }

    /* ══════════════════════════════════════
       TABS
    ══════════════════════════════════════ */
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });

    /* ══════════════════════════════════════
       FILE HANDLING
    ══════════════════════════════════════ */
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('fileInput');
    const analyzeBtn = document.getElementById('analyzeBtn');
    let selectedFile = null;

    ['dragenter', 'dragover'].forEach(e => dropZone.addEventListener(e, ev => { ev.preventDefault(); dropZone.classList.add('drag-over'); }));
    ['dragleave', 'drop'].forEach(e => dropZone.addEventListener(e, ev => { ev.preventDefault(); dropZone.classList.remove('drag-over'); }));
    dropZone.addEventListener('drop', e => { const f = e.dataTransfer.files[0]; if (f) handleFile(f); });
    dropZone.addEventListener('click', e => { if (!e.target.closest('.file-selected') && !e.target.closest('.remove-file')) fileInput.click(); });
    document.getElementById('browseBtn').addEventListener('click', e => { e.stopPropagation(); fileInput.click(); });
    fileInput.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });

    function handleFile(f) {
      const ext = f.name.split('.').pop().toLowerCase();
      if (!['pdf', 'docx'].includes(ext)) { toast('Please upload a PDF or DOCX file', 'error'); return; }
      if (f.size > 16 * 1024 * 1024) { toast('File exceeds 16 MB limit', 'error'); return; }
      selectedFile = f;
      document.getElementById('fileName').textContent = f.name;
      document.getElementById('fileSize').textContent = fmtBytes(f.size);
      document.getElementById('dropZoneInner').classList.add('hidden');
      document.getElementById('fileSelected').classList.remove('hidden');
      analyzeBtn.disabled = false;
    }
    document.getElementById('removeFile').addEventListener('click', e => { e.stopPropagation(); resetFile(); });
    function resetFile() {
      selectedFile = null; fileInput.value = '';
      document.getElementById('fileSelected').classList.add('hidden');
      document.getElementById('dropZoneInner').classList.remove('hidden');
      analyzeBtn.disabled = true;
    }

    /* JD Toggle */
    document.getElementById('jdToggle').addEventListener('click', () => {
      const jdBody = document.getElementById('jdBody');
      const chev = document.getElementById('jdChevron');
      jdBody.classList.toggle('hidden');
      chev.classList.toggle('open', !jdBody.classList.contains('hidden'));
    });

    /* ══════════════════════════════════════
       COMPARE CVs
    ══════════════════════════════════════ */
    /* ══════════════════════════════════════
       RANK CANDIDATES (several CVs vs one job)
    ══════════════════════════════════════ */
    const MAX_RANK = 5;
    let rankFiles = [];
    const rankInput = document.getElementById('rankFiles');
    const rankDrop = document.getElementById('rankDrop');
    const rankBtn = document.getElementById('rankBtn');

    rankDrop.addEventListener('click', () => rankInput.click());
    rankDrop.addEventListener('dragover', e => { e.preventDefault(); rankDrop.classList.add('drag-over'); });
    rankDrop.addEventListener('dragleave', () => rankDrop.classList.remove('drag-over'));
    rankDrop.addEventListener('drop', e => {
      e.preventDefault(); rankDrop.classList.remove('drag-over');
      addRankFiles(e.dataTransfer.files);
    });
    rankInput.addEventListener('change', () => { addRankFiles(rankInput.files); rankInput.value = ''; });
    document.getElementById('rankJD').addEventListener('input', checkRank);

    function addRankFiles(fileList) {
      for (const f of fileList) {
        const ext = f.name.split('.').pop().toLowerCase();
        if (!['pdf', 'docx'].includes(ext)) { toast(f.name + ': PDF or DOCX only', 'error'); continue; }
        if (rankFiles.some(x => x.name === f.name && x.size === f.size)) continue;
        if (rankFiles.length >= MAX_RANK) { toast('Maximum ' + MAX_RANK + ' CVs', 'error'); break; }
        rankFiles.push(f);
      }
      renderRankFiles();
    }
    function renderRankFiles() {
      const box = document.getElementById('rankFileList');
      box.innerHTML = rankFiles.map((f, i) => `
        <div class="rank-file"><i class="fa-regular fa-file-lines"></i>
          <span>${esc(f.name)}</span><small>${fmtBytes(f.size)}</small>
          <button data-i="${i}" title="Remove"><i class="fa-solid fa-xmark"></i></button>
        </div>`).join('');
      box.querySelectorAll('button').forEach(b => b.addEventListener('click', () => {
        rankFiles.splice(+b.dataset.i, 1); renderRankFiles();
      }));
      checkRank();
    }
    function checkRank() {
      rankBtn.disabled = !(rankFiles.length >= 2 && document.getElementById('rankJD').value.trim().length >= 20);
    }

    rankBtn.addEventListener('click', async () => {
      const fd = new FormData();
      rankFiles.forEach(f => fd.append('files', f));
      fd.append('job_description', document.getElementById('rankJD').value.trim());
      fd.append('language', getLang('rankLang'));
      window._rankLang = getLang('rankLang');
      const title = document.querySelector('.loading-title');
      title.textContent = 'Ranking candidates…';
      showLoading();
      try {
        const res = await fetch(API + '/api/compare', { method: 'POST', body: fd, headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
        renderRanking(data.ranking || []);
      } catch (err) {
        toast('Ranking failed: ' + err.message, 'error');
      } finally {
        hideLoading();
        title.textContent = 'Analyzing CV…';
        checkRank();
      }
    });

    function renderRanking(list) {
      const box = document.getElementById('rankResults');
      const medals = ['🥇', '🥈', '🥉'];
      window._ranking = list;
      box.innerHTML = list.map((c, idx) => {
        if (c.error) {
          return `<div class="rank-card rank-fail"><div class="rank-head"><div class="rank-pos">⚠️</div>
            <div class="rank-id"><h4>${esc(c.fileName)}</h4><p class="rank-note">${esc(c.error)}</p></div></div></div>`;
        }
        const m = typeof c.match_score === 'number' ? Math.max(0, Math.min(100, c.match_score)) : null;
        const chips = (arr, cls) => (arr || []).slice(0, 8).map(s => `<span class="rank-chip ${cls}">${esc(s)}</span>`).join('');
        return `
        <div class="rank-card ${c.rank === 1 ? 'rank-top' : ''}">
          <div class="rank-head">
            <div class="rank-pos">${medals[c.rank - 1] || '#' + c.rank}</div>
            <div class="rank-id">
              <h4>${esc(c.candidate_name || c.fileName)}${c.rank === 1 ? '<span class="rank-badge">Best fit</span>' : ''}</h4>
              <p class="rank-sub">${esc(c.experience_level || '')} · ${esc(c.experience_years ?? '?')} yrs · ${esc(c.fileName)}</p>
            </div>
            <div class="rank-match"><span class="rank-match-num">${m === null ? '—' : m}</span><small>match</small></div>
          </div>
          <div class="rank-bar"><div class="rank-bar-fill" style="width:${m ?? 0}%"></div></div>
          <div class="rank-ats">ATS score: ${esc(c.ats_score)}/100${c.skill_coverage != null ? ' · Skills coverage: ' + esc(c.skill_coverage) + '%' : ''}</div>
          ${(c.matched_skills || []).length ? `<div class="rank-chips">${chips(c.matched_skills, 'ok')}</div>` : ''}
          ${(c.missing_skills || []).length ? `<div class="rank-chips">${chips(c.missing_skills, 'miss')}</div>` : ''}
          ${(c.strengths || [])[0] ? `<p class="rank-note" dir="auto"><b>Strength:</b> ${esc(c.strengths[0])}</p>` : ''}
          ${(c.weaknesses || [])[0] ? `<p class="rank-note" dir="auto"><b>Gap:</b> ${esc(c.weaknesses[0])}</p>` : ''}
          <button class="rank-view-btn" data-idx="${idx}"><i class="fa-solid fa-magnifying-glass-chart"></i> View full analysis</button>
        </div>`;
      }).join('');
      box.querySelectorAll('.rank-view-btn').forEach(b =>
        b.addEventListener('click', () => viewFullAnalysis(+b.dataset.idx)));
      box.classList.remove('hidden');
      box.scrollIntoView({ behavior: 'smooth' });
    }

    /* Open the full report of a ranked candidate, with a way back to the ranking */
    function viewFullAnalysis(idx) {
      const c = (window._ranking || [])[idx];
      if (!c || c.error) return;
      document.getElementById('tab-compare').classList.remove('active');
      window._src = { file: rankFiles.find(f => f.name === c.fileName) || null, jd: document.getElementById('rankJD').value.trim(), lang: window._rankLang || getLang('rankLang'), data: c };
      renderResults(c, true);
      document.getElementById('backRankBtn').classList.remove('hidden');
    }
    document.getElementById('backRankBtn').addEventListener('click', () => {
      document.getElementById('resultsSection').classList.add('hidden');
      document.getElementById('backRankBtn').classList.add('hidden');
      document.getElementById('tab-compare').classList.add('active');
      document.getElementById('rankResults').scrollIntoView({ behavior: 'smooth' });
    });

    /* ══════════════════════════════════════
       ANALYZE
    ══════════════════════════════════════ */
    analyzeBtn.addEventListener('click', runAnalysis);
    async function runAnalysis() {
      if (!selectedFile) return;
      showLoading();
      const fd = new FormData();
      fd.append('file', selectedFile);
      const jd = document.getElementById('jobDescription').value.trim();
      if (jd) fd.append('job_description', jd);
      fd.append('language', getLang('langSelect'));
      try {
        const res = await fetch(API + '/api/analyze', { method: 'POST', body: fd, headers: authHeaders() });
        if (!res.ok) throw new Error((await res.json().catch(() => ({ error: 'Server error' }))).error || `HTTP ${res.status}`);
        const data = await res.json();
        hideLoading();
        saveToHistory(data);
        window._src = { file: selectedFile, jd, lang: getLang('langSelect'), data };
        renderResults(data, !!jd);
      } catch (err) {
        hideLoading();
        toast(`Analysis failed: ${err.message}`, 'error');
      }
    }

    /* Loading */
    let stepTimer = null;
    function showLoading() {
      analyzeBtn.disabled = true;
      document.getElementById('loadingOverlay').classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      const steps = document.querySelectorAll('#loadingSteps .step');
      let cur = 0;
      steps.forEach(s => s.classList.remove('active', 'done'));
      steps[0].classList.add('active');
      stepTimer = setInterval(() => {
        if (cur < steps.length - 1) {
          steps[cur].classList.remove('active'); steps[cur].classList.add('done');
          cur++; steps[cur].classList.add('active');
        }
      }, 600);
    }
    function hideLoading() {
      clearInterval(stepTimer);
      analyzeBtn.disabled = !selectedFile; // re-enable after an error
      document.getElementById('loadingOverlay').classList.add('hidden');
      document.body.style.overflow = '';
    }

    /* ══════════════════════════════════════
       RENDER RESULTS
    ══════════════════════════════════════ */
    /* Score breakdown: real values from the AI, with a fallback for old saved analyses */
    function computeBreakdown(data) {
      const b = data.breakdown;
      if (b && ['format', 'keywords', 'experience', 'education', 'skills'].every(k => Number.isFinite(+b[k]))) {
        return [
          { label: 'Format', value: Math.round(b.format) },
          { label: 'Keywords', value: Math.round(b.keywords) },
          { label: 'Experience', value: Math.round(b.experience) },
          { label: 'Education', value: Math.round(b.education) },
          { label: 'Skills', value: Math.round(b.skills) },
        ];
      }
      const ats = Number(data.ats_score) || 0;
      return [
        { label: 'Format', value: Math.min(100, Math.round(ats * 1.1)) },
        { label: 'Keywords', value: Math.round(ats * 0.9) },
        { label: 'Experience', value: Math.min(100, data.experience_years ? data.experience_years * 10 : 60) },
        { label: 'Education', value: data.education && data.education !== '—' ? 85 : 50 },
        { label: 'Skills', value: Math.min(100, (data.skills || []).length * 7) },
      ];
    }

    function renderResults(data, hasJD) {
      window._lastResult = data;
      document.getElementById('backDashBtn').classList.add('hidden');
      document.getElementById('rewriteBtn').classList.toggle('hidden', !(((window._src && window._src.data === data && window._src.file) || data._analysisId) && !(window._user && window._user.role === 'recruiter')));
      document.getElementById('backRankBtn').classList.add('hidden');
      document.getElementById('uploadSection').classList.add('hidden');
      document.getElementById('resultsSection').classList.remove('hidden');

      const initials = (data.candidate_name || '').split(' ').filter(Boolean).slice(0, 2).map(w => w[0].toUpperCase()).join('');
      document.getElementById('avatarInitials').textContent = initials;
      document.getElementById('candidateName').textContent = data.candidate_name || '—';
      document.getElementById('expLevel').textContent = data.experience_level || '—';
      document.getElementById('educationText').textContent = data.education || '—';

      animCircle('atsFill', data.ats_score);
      animCount('atsScoreText', data.ats_score);
      document.getElementById('atsRating').textContent = rating(data.ats_score);

      const mc = document.getElementById('matchScoreCard');
      if (hasJD && data.match_score != null) {
        mc.classList.remove('hidden');
        animCircle('matchFill', data.match_score);
        animCount('matchScoreText', data.match_score);
        document.getElementById('matchRating').textContent = rating(data.match_score);
      } else mc.classList.add('hidden');

      setTimeout(() => {
        document.getElementById('atsBarFill').style.width = data.ats_score + '%';
        animCount('atsBarPct', data.ats_score, '%');
      }, 100);

      /* Detailed Score Breakdown */
      const breakdown = computeBreakdown(data);
      const ds = document.getElementById('detailedScores');
      ds.innerHTML = '';
      breakdown.forEach((b, i) => {
        const el = document.createElement('div');
        el.className = 'detail-score-item';
        el.innerHTML = `<div class="ds-label">${b.label}</div><div class="ds-bar"><div class="ds-fill" data-val="${b.value}"></div></div><div class="ds-value">${b.value}</div>`;
        ds.appendChild(el);
        setTimeout(() => { el.querySelector('.ds-fill').style.width = b.value + '%'; }, 200 + i * 80);
      });

      /* Skills */
      const cloud = document.getElementById('skillsCloud');
      cloud.innerHTML = '';
      (data.skills || []).forEach((s, i) => {
        const t = document.createElement('span');
        t.className = 'skill-tag'; t.textContent = s;
        t.style.animationDelay = i * 40 + 'ms';
        cloud.appendChild(t);
      });

      renderList('strengthsList', data.strengths || [], 'fa-check', 'bullet-green');
      renderList('weaknessesList', data.weaknesses || [], 'fa-minus', 'bullet-amber');
      renderList('suggestionsList', data.suggestions || [], 'fa-arrow-up-right', 'bullet-gold');

      document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
    }

    function renderList(id, items, icon, cls) {
      const ul = document.getElementById(id); ul.innerHTML = '';
      items.forEach((text, i) => {
        const li = document.createElement('li');
        li.className = 'insight-item'; li.style.animationDelay = i * 80 + 'ms';
        li.innerHTML = `<span class="insight-bullet ${cls}"><i class="fa-solid ${icon}"></i></span><span dir="auto">${esc(text)}</span>`;
        ul.appendChild(li);
      });
    }

    /* ══════════════════════════════════════
       EXPORT PDF
    ══════════════════════════════════════ */
    document.getElementById('exportBtn').addEventListener('click', () => {
      const data = window._lastResult;
      if (!data) return;
      const reportHTML = `<!DOCTYPE html><html><head><meta charset="UTF-8"/>
  <title>CVision Report</title>
  <style>
    *{box-sizing:border-box;margin:0;padding:0;}
    body{font-family:Georgia,serif;background:#fff;color:#1a1712;padding:40px;}
    .header{border-bottom:3px solid #c8aa64;padding-bottom:20px;margin-bottom:24px;display:flex;align-items:center;gap:16px;}
    .avatar{width:60px;height:60px;border-radius:50%;background:linear-gradient(135deg,#c8aa64,#6b4e12);display:flex;align-items:center;justify-content:center;color:#fff;font-size:1.4rem;font-weight:700;}
    .name{font-size:2rem;font-weight:700;}.meta{font-size:0.9rem;color:#6b6355;margin-top:4px;}
    .badge{display:inline-block;padding:2px 10px;border-radius:99px;background:#f5e6b8;color:#a07830;font-size:0.75rem;font-weight:600;border:1px solid #c8aa64;}
    .scores{display:flex;gap:16px;margin-bottom:24px;}
    .score-box{flex:1;border:1px solid #e8dcc8;border-radius:12px;padding:16px;text-align:center;background:#faf8f4;}
    .score-num{font-size:2.5rem;font-weight:700;color:#c8aa64;line-height:1;}
    .score-lbl{font-size:0.72rem;text-transform:uppercase;letter-spacing:0.1em;color:#9a9484;margin-top:4px;}
    .sec{margin-bottom:24px;}
    .sec-title{font-size:0.85rem;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#a07830;margin-bottom:12px;padding-bottom:6px;border-bottom:1px solid #e8dcc8;}
    .breakdown{display:flex;gap:10px;flex-wrap:wrap;}
    .bd{flex:1;min-width:80px;border:1px solid #e8dcc8;border-radius:8px;padding:10px;text-align:center;background:#faf8f4;}
    .bd-val{font-size:1.3rem;font-weight:700;color:#c8aa64;}.bd-lbl{font-size:0.65rem;text-transform:uppercase;color:#9a9484;}
    .skills{display:flex;flex-wrap:wrap;gap:6px;}
    .skill{padding:4px 12px;border-radius:99px;border:1px solid #c8aa64;background:#fdf8ee;color:#a07830;font-size:0.8rem;}
    .three-col{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px;}
    .col-title{font-size:0.85rem;font-weight:700;margin-bottom:10px;}
    .list{list-style:none;display:flex;flex-direction:column;gap:6px;}
    .list li{padding:7px 10px;border-radius:6px;font-size:0.82rem;line-height:1.5;display:flex;gap:6px;align-items:flex-start;}
    .li-s{background:#f0fdf4;border:1px solid #86efac;color:#166534;}
    .li-w{background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;}
    .li-g{background:#fefce8;border:1px solid #fde68a;color:#92400e;}
    .dot{width:8px;height:8px;border-radius:50%;flex-shrink:0;margin-top:4px;}
    .dot-g{background:#4ade80;}.dot-a{background:#fb923c;}.dot-y{background:#c8aa64;}
    .footer{margin-top:32px;padding-top:12px;border-top:1px solid #e8dcc8;font-size:0.75rem;color:#9a9484;text-align:center;}
    .green{color:#16a34a;}.amber{color:#ea580c;}.gold{color:#a07830;}
  </style></head><body>
  <div class="header">
    <div class="avatar">${esc((data.candidate_name || '').split(' ').filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase())}</div>
    <div><div class="name">${esc(data.candidate_name || '—')}</div>
    <div class="meta"><span class="badge">${esc(data.experience_level || '—')}</span> &nbsp;${esc(data.education || '')}</div></div>
  </div>
  <div class="scores">
    <div class="score-box"><div class="score-num">${data.ats_score}</div><div class="score-lbl">ATS Score</div></div>
    ${data.match_score != null ? `<div class="score-box"><div class="score-num" style="color:#60a5fa">${data.match_score}</div><div class="score-lbl">Job Match</div></div>` : ''}
    <div class="score-box"><div class="score-num">${data.experience_years ?? '—'}</div><div class="score-lbl">Years Exp.</div></div>
  </div>
  <div class="sec"><div class="sec-title">Score Breakdown</div>
    <div class="breakdown">
      ${computeBreakdown(data).map(b => `<div class="bd"><div class="bd-val">${b.value}</div><div class="bd-lbl">${b.label}</div></div>`).join('')}
    </div>
  </div>
  <div class="sec"><div class="sec-title">Detected Skills</div>
    <div class="skills">${(data.skills || []).map(s => `<span class="skill">${esc(s)}</span>`).join('')}</div>
  </div>
  <div class="three-col">
    <div><div class="col-title green">✓ Strengths</div><ul class="list">${(data.strengths || []).map(s => `<li class="li-s" dir="auto"><span class="dot dot-g"></span>${esc(s)}</li>`).join('')}</ul></div>
    <div><div class="col-title amber">⚠ Areas</div><ul class="list">${(data.weaknesses || []).map(s => `<li class="li-w" dir="auto"><span class="dot dot-a"></span>${esc(s)}</li>`).join('')}</ul></div>
    <div><div class="col-title gold">💡 Suggestions</div><ul class="list">${(data.suggestions || []).map(s => `<li class="li-g" dir="auto"><span class="dot dot-y"></span>${esc(s)}</li>`).join('')}</ul></div>
  </div>
  <div class="footer">CVision — AI-Powered CV Analyzer · ${new Date().toLocaleDateString()}</div>
  </body></html>`;
      printReport(reportHTML);
    });

    /* Print through a hidden iframe (no popup, so it is not blocked); download as a fallback */
    function printReport(html) {
      const f = document.createElement('iframe');
      f.style.cssText = 'position:fixed;right:0;bottom:0;width:0;height:0;border:0;';
      f.srcdoc = html;
      f.onload = () => {
        try {
          f.contentWindow.focus();
          f.contentWindow.print();
        } catch (e) {
          downloadReport(html);
        }
        setTimeout(() => f.remove(), 60000);
      };
      document.body.appendChild(f);
    }
    function downloadReport(html) {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([html], { type: 'text/html' }));
      a.download = 'cvision-report.html';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
      toast('Print is not available here, report downloaded instead');
    }

    /* ══════════════════════════════════════
       HISTORY
    ══════════════════════════════════════ */
    function saveToHistory(data) {
      if (authToken) return; // logged in: the backend saves it in the database
      const history = JSON.parse(localStorage.getItem('cvision-history') || '[]');
      history.unshift({
        name: data.candidate_name || 'Unknown',
        score: data.ats_score,
        level: data.experience_level,
        date: new Date().toLocaleDateString(),
        data
      });
      localStorage.setItem('cvision-history', JSON.stringify(history.slice(0, 20)));
    }

    document.getElementById('historyBtn').addEventListener('click', openHistory);
    document.getElementById('closeHistory').addEventListener('click', () => {
      document.getElementById('historyOverlay').classList.add('hidden');
    });
    document.getElementById('historyOverlay').addEventListener('click', e => {
      if (e.target === e.currentTarget) e.currentTarget.classList.add('hidden');
    });

    function openLocalHistory() {
      const overlay = document.getElementById('historyOverlay');
      overlay.classList.remove('hidden');
      const list = document.getElementById('historyList');
      const history = JSON.parse(localStorage.getItem('cvision-history') || '[]');
      if (!history.length) {
        list.innerHTML = '<div class="history-empty"><i class="fa-solid fa-clock-rotate-left" style="font-size:1.5rem;margin-bottom:8px;display:block;"></i>No analyses yet</div>';
        return;
      }
      list.innerHTML = '';
      history.forEach(item => {
        const el = document.createElement('div');
        el.className = 'history-item';
        el.innerHTML = `
      <div class="h-name">${esc(item.name)}</div>
      <div class="h-meta">
        <span class="h-score">${esc(item.score)}/100</span>
        <span class="h-level">${esc(item.level)}</span>
        <span class="h-date">${item.date}</span>
      </div>
    `;
        el.addEventListener('click', () => {
          overlay.classList.add('hidden');
          document.getElementById('uploadSection').classList.add('hidden');
          document.getElementById('resultsSection').classList.remove('hidden');
          renderResults(item.data, false);
        });
        list.appendChild(el);
      });
    }

    /* ══════════════════════════════════════
       RESET
    ══════════════════════════════════════ */
    document.getElementById('resetBtn').addEventListener('click', () => {
      document.getElementById('resultsSection').classList.add('hidden');
      document.querySelector('.tab-btn[data-tab="upload"]').click();
      document.getElementById('uploadSection').classList.remove('hidden');
      resetFile();
      document.getElementById('jobDescription').value = '';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    /* ══════════════════════════════════════
       HELPERS
    ══════════════════════════════════════ */
    function animCircle(id, val) {
      const el = document.getElementById(id);
      el.style.strokeDasharray = '0,100';
      requestAnimationFrame(() => requestAnimationFrame(() => { el.style.strokeDasharray = val + ',100'; }));
    }
    function animCount(id, target, suffix = '') {
      const el = document.getElementById(id);
      const dur = 1200; const start = performance.now();
      (function step(now) {
        const p = Math.min((now - start) / dur, 1);
        el.textContent = Math.round((1 - Math.pow(1 - p, 3)) * target) + suffix;
        if (p < 1) requestAnimationFrame(step);
      })(start);
    }
    function fmtBytes(b) { if (b < 1024) return b + ' B'; if (b < 1048576) return (b / 1024).toFixed(1) + ' KB'; return (b / 1048576).toFixed(1) + ' MB'; }
    function rating(s) { if (s >= 85) return '✦ Excellent'; if (s >= 70) return '◈ Good'; if (s >= 50) return '◇ Average'; return '△ Needs Work'; }
    function toast(msg, type = 'info') {
      document.querySelector('.toast')?.remove();
      const t = document.createElement('div'); t.className = 'toast';
      t.style.cssText = `position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(8px);
    background:var(--bg-card);border:1px solid ${type === 'error' ? 'var(--red)' : 'var(--gold)'};
    color:var(--text-primary);padding:12px 20px;border-radius:var(--radius-md);
    font-size:0.88rem;box-shadow:var(--shadow-card);z-index:9999;
    opacity:0;transition:all 0.3s ease;white-space:nowrap;max-width:90vw;font-family:'DM Sans',sans-serif;`;
      t.textContent = msg; document.body.appendChild(t);
      requestAnimationFrame(() => { t.style.opacity = '1'; t.style.transform = 'translateX(-50%) translateY(0)'; });
      setTimeout(() => { t.style.opacity = '0'; t.style.transform = 'translateX(-50%) translateY(8px)'; setTimeout(() => t.remove(), 300); }, 3500);
    }

    /* ══════════════════════════════════════
       AUTH + SERVER HISTORY
    ══════════════════════════════════════ */
    const API = (location.hostname === 'localhost' || location.hostname === '127.0.0.1')
      ? 'http://localhost:5000'
      : 'https://cv-analyzer-zuyf.onrender.com';

    let authToken = null;
    try { authToken = localStorage.getItem('cvision-token'); } catch (e) { }
    let authMode = 'login';

    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }
    function authHeaders() { return authToken ? { Authorization: 'Bearer ' + authToken } : {}; }

    function setUser(user) {
      document.getElementById('authBtn').classList.toggle('hidden', !!user);
      document.getElementById('userChip').classList.toggle('hidden', !user);
      document.getElementById('userName').textContent = user ? user.name : '';
      window._user = user || null;
      if (typeof refreshJobs === 'function') refreshJobs();
      const dtb = document.getElementById('dashTabBtn');
      if (dtb) {
        const isRec = !!user && user.role === 'recruiter';
        dtb.classList.toggle('hidden', !isRec);
        if (!isRec) {
          window._dash = null;
          if (document.getElementById('tab-dashboard').classList.contains('active')) document.querySelector('.tab-btn[data-tab="upload"]').click();
        }
      }
    }
    function logout(silent) {
      authToken = null;
      try { localStorage.removeItem('cvision-token'); } catch (e) { }
      setUser(null);
      if (!silent) toast('Logged out');
    }
    async function loadMe() {
      if (!authToken) return setUser(null);
      try {
        const res = await fetch(API + '/api/auth/me', { headers: authHeaders() });
        if (res.status === 401) throw new Error('bad token');
        if (!res.ok) return; // server down: keep the session
        setUser((await res.json()).user);
      } catch (e) { logout(true); }
    }

    function setAuthMode(mode) {
      authMode = mode;
      resetVerifyUI();
      const reg = mode === 'register';
      document.getElementById('authTitle').textContent = reg ? 'Create account' : 'Login';
      document.getElementById('authSubmit').textContent = reg ? 'Register' : 'Login';
      document.getElementById('authName').classList.toggle('hidden', !reg);
      document.getElementById('authRole').classList.toggle('hidden', !reg);
      document.getElementById('pwRules').classList.toggle('hidden', !reg);
      document.getElementById('authForgot').classList.toggle('hidden', mode !== 'login');
      document.getElementById('authPassword').placeholder = 'Password';
      updatePwRules();
      document.getElementById('authSwitchText').textContent = reg ? 'Already have an account?' : 'No account?';
      document.getElementById('authSwitchBtn').textContent = reg ? 'Login' : 'Register';
      document.getElementById('authPassword').autocomplete = reg ? 'new-password' : 'current-password';
      document.getElementById('authError').textContent = '';
    }
    function openAuth() { setAuthMode('login'); document.getElementById('authOverlay').classList.remove('hidden'); }
    function closeAuth() { document.getElementById('authOverlay').classList.add('hidden'); }

    document.getElementById('authBtn').addEventListener('click', openAuth);
    document.getElementById('authClose').addEventListener('click', closeAuth);
    document.getElementById('authOverlay').addEventListener('click', e => { if (e.target === e.currentTarget) closeAuth(); });
    document.getElementById('authSwitchBtn').addEventListener('click', () => setAuthMode(authMode === 'login' ? 'register' : 'login'));
    document.getElementById('logoutBtn').addEventListener('click', () => logout(false));
    ['authName', 'authEmail', 'authPassword'].forEach(id =>
      document.getElementById(id).addEventListener('keydown', e => { if (e.key === 'Enter') submitAuth(); }));
    document.getElementById('authSubmit').addEventListener('click', submitAuth);

    async function submitAuth() {
      if (authMode === 'verify') return submitVerify();
      if (authMode === 'forgot') return submitForgot();
      if (authMode === 'reset') return submitReset();
      const btn = document.getElementById('authSubmit');
      const err = document.getElementById('authError');
      const name = document.getElementById('authName').value.trim();
      const email = document.getElementById('authEmail').value.trim();
      const password = document.getElementById('authPassword').value;
      err.textContent = '';
      if (!email || !password || (authMode === 'register' && !name)) { err.textContent = 'Please fill in all fields.'; return; }
      if (authMode === 'register') { const miss = pwProblems(password); if (miss.length) { err.textContent = 'Password needs: ' + miss.join(', '); return; } }
      btn.disabled = true;
      try {
        const body = authMode === 'register' ? { name, email, password, role: document.getElementById('authRole').value } : { email, password };
        const res = await fetch(API + '/api/auth/' + authMode, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
        });
        const data = await res.json().catch(() => ({}));
        if (data.needsVerification) { showVerifyStep(data.email || email, authMode === 'register'); return; }
        if (!res.ok) throw new Error(data.error || 'Request failed');
        authToken = data.token;
        try { localStorage.setItem('cvision-token', authToken); } catch (e) { }
        setUser(data.user);
        closeAuth();
        ['authName', 'authEmail', 'authPassword'].forEach(id => document.getElementById(id).value = '');
        toast('Welcome ' + data.user.name + ' 👋');
      } catch (e) {
        err.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    }

    async function openHistory() {
      if (!authToken) return openLocalHistory();
      const overlay = document.getElementById('historyOverlay');
      const list = document.getElementById('historyList');
      overlay.classList.remove('hidden');
      list.innerHTML = '<div class="history-empty">Loading…</div>';
      try {
        const res = await fetch(API + '/api/history', { headers: authHeaders() });
        if (res.status === 401) { logout(true); toast('Session expired, please login again', 'error'); overlay.classList.add('hidden'); return; }
        if (!res.ok) throw new Error('Server error');
        const items = await res.json();
        if (!items.length) {
          list.innerHTML = '<div class="history-empty"><i class="fa-solid fa-clock-rotate-left" style="font-size:1.5rem;margin-bottom:8px;display:block;"></i>No analyses yet</div>';
          return;
        }
        list.innerHTML = '';
        items.forEach(item => {
          const r = item.result || {};
          const el = document.createElement('div');
          el.className = 'history-item';
          el.innerHTML = `
            <div class="h-top">
              <div class="h-name">${esc(r.candidate_name || item.fileName || 'Unknown')}</div>
              <button class="h-delete" title="Delete"><i class="fa-solid fa-trash"></i></button>
            </div>
            <div class="h-meta">
              <span class="h-score">${esc(r.ats_score)}/100</span>
              <span class="h-level">${esc(r.experience_level || '')}</span>
              <span class="h-date">${new Date(item.createdAt).toLocaleDateString()}</span>
            </div>`;
          el.addEventListener('click', async () => {
            try {
              const r2 = await fetch(API + '/api/history/' + item._id, { headers: authHeaders() });
              if (!r2.ok) throw new Error('Not found');
              const full = await r2.json();
              overlay.classList.add('hidden');
              renderResults(full.result, !!full.hasJobDescription);
            } catch (e) { toast('Could not load this analysis', 'error'); }
          });
          el.querySelector('.h-delete').addEventListener('click', async ev => {
            ev.stopPropagation();
            if (!confirm('Delete this analysis?')) return;
            try {
              const d = await fetch(API + '/api/history/' + item._id, { method: 'DELETE', headers: authHeaders() });
              if (!d.ok) throw new Error();
              el.remove();
              if (!list.children.length) openHistory();
            } catch (e) { toast('Delete failed', 'error'); }
          });
          list.appendChild(el);
        });
      } catch (e) {
        list.innerHTML = '<div class="history-empty">Could not load history.</div>';
      }
    }

    loadMe();
    // Language selectors (shared, remembered between visits)
    const LANG_IDS = ['langSelect', 'rankLang'];
    function getLang(id) {
      const v = document.getElementById(id).value;
      return ['en', 'fr', 'ar'].includes(v) ? v : 'en';
    }
    (function initLang() {
      let saved = 'en';
      try { saved = localStorage.getItem('cvision-lang') || 'en'; } catch (e) { }
      LANG_IDS.forEach(id => {
        const el = document.getElementById(id);
        el.value = saved;
        el.addEventListener('change', () => {
          LANG_IDS.forEach(o => { document.getElementById(o).value = el.value; });
          try { localStorage.setItem('cvision-lang', el.value); } catch (e) { }
        });
      });
    })();

    // CV rewriting
    const rwOverlay = document.getElementById('rwOverlay');
    function closeRewrite() { rwOverlay.classList.add('hidden'); }
    document.getElementById('rwClose').addEventListener('click', closeRewrite);
    rwOverlay.addEventListener('click', e => { if (e.target === e.currentTarget) closeRewrite(); });

    document.getElementById('rewriteBtn').addEventListener('click', async () => {
      const src = window._src;
      if (!src || src.data !== window._lastResult || !src.file) {
        if (window._lastResult && window._lastResult._analysisId) return rewriteFromHistory(window._lastResult._analysisId);
        return;
      }
      const fd = new FormData();
      fd.append('file', src.file);
      if (src.jd) fd.append('job_description', src.jd);
      fd.append('language', src.lang);
      fd.append('suggestions', JSON.stringify((src.data && src.data.suggestions) || []));
      const title = document.querySelector('.loading-title');
      title.textContent = 'Rewriting your CV…';
      showLoading();
      try {
        const res = await fetch(API + '/api/rewrite', { method: 'POST', body: fd, headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
        showRewrite(data);
      } catch (err) {
        toast('Rewrite failed: ' + err.message, 'error');
      } finally {
        hideLoading();
        title.textContent = 'Analyzing CV…';
      }
    });

    function showRewrite(d) {
      window._rewritten = d.rewritten_cv || '';
      const block = (t, arr) => (arr && arr.length)
        ? `<p class="rw-h">${t}</p><ul class="rw-list">${arr.map(x => `<li dir="auto">${esc(x)}</li>`).join('')}</ul>`
        : '';
      document.getElementById('rwNotes').innerHTML =
        block('What changed', d.changes) + block('Add this yourself (we never invent facts)', d.missing_info);
      document.getElementById('rwNotes').insertAdjacentHTML('afterbegin', scoreBoard(d.after));
      document.getElementById('rwText').textContent = window._rewritten;
      rwOverlay.classList.remove('hidden');
    }

    document.getElementById('rwCopy').addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(window._rewritten || ''); toast('Copied'); }
      catch (e) { toast('Copy failed, select the text manually', 'error'); }
    });
    document.getElementById('rwDownload').addEventListener('click', () => {
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob(['\uFEFF' + (window._rewritten || '')], { type: 'text/plain;charset=utf-8' }));
      a.download = 'cv-improved.txt';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    });
    document.getElementById('rwPrint').addEventListener('click', () => {
      printReport(`<!DOCTYPE html><html><head><meta charset="UTF-8"><title>CV</title><style>body{font-family:Georgia,serif;padding:40px;color:#1a1712;}pre{white-space:pre-wrap;font:inherit;line-height:1.6;}</style></head><body><pre dir="auto">${esc(window._rewritten || '')}</pre></body></html>`);
    });

    // Recruiter dashboard
    const dashBtn = document.createElement('button');
    dashBtn.className = 'tab-btn hidden';
    dashBtn.id = 'dashTabBtn';
    dashBtn.dataset.tab = 'dashboard';
    dashBtn.innerHTML = '<i class="fa-solid fa-chart-pie"></i> Dashboard';
    document.querySelector('.main-tabs').appendChild(dashBtn);
    dashBtn.classList.toggle('hidden', !(window._user && window._user.role === 'recruiter'));
    dashBtn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      dashBtn.classList.add('active');
      document.getElementById('tab-dashboard').classList.add('active');
      document.getElementById('resultsSection').classList.add('hidden');
      loadDashboard();
    });

    const dashBody = document.getElementById('dashBody');

    async function loadDashboard() {
      dashBody.innerHTML = '<div class="history-empty">Loading…</div>';
      try {
        const res = await fetch(API + '/api/recruiter/stats', { headers: authHeaders() });
        if (res.status === 401) { logout(true); throw new Error('Session expired, please login again'); }
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'HTTP ' + res.status);
        window._dash = d;
        renderDashboard(d);
      } catch (e) {
        dashBody.innerHTML = `<div class="history-empty">${esc(e.message)}</div>`;
      }
    }

    function barRows(entries) {
      const max = Math.max(1, ...entries.map(e => e[1]));
      return entries.map(([label, n]) =>
        `<div class="dash-bar-row"><span class="lbl" title="${esc(label)}">${esc(label)}</span><div class="dash-bar-track"><div class="dash-bar-fill" style="width:${n / max * 100}%"></div></div><span>${n}</span></div>`
      ).join('');
    }

    function renderDashboard(d) {
      if (!d.total) {
        dashBody.innerHTML = '<div class="history-empty">No candidates yet. Analyze or rank CVs while logged in and they will appear here.</div>';
        return;
      }
      const stat = (v, l) => `<div class="dash-stat"><b>${esc(v)}</b><span>${l}</span></div>`;
      const levels = Object.keys(d.levels);
      dashBody.innerHTML = `
        <div class="dash-stats">
          ${stat(d.total, 'Candidates')}${stat(d.avgAts ?? '—', 'Avg ATS')}${stat(d.avgMatch ?? '—', 'Avg job match')}${stat(d.strong, 'Strong (70+)')}
        </div>
        <div class="dash-grid">
          <div class="dash-box"><h4>Experience levels</h4>${barRows(Object.entries(d.levels).sort((a, b) => b[1] - a[1]))}</div>
          <div class="dash-box"><h4>Top skills</h4>${barRows(d.topSkills.map(s => [s.name, s.count])) || '<span class="dash-sub">No skills yet</span>'}</div>
        </div>
        ${pipelineHtml(d)}
        <div class="dash-filters">
          <input id="dashSearch" type="search" placeholder="Search name or file…" />
          <select id="dashLevel"><option value="">All levels</option>${levels.map(l => `<option>${esc(l)}</option>`).join('')}</select>
          <select id="dashStatus"><option value="">All statuses</option><option value="new">New</option><option value="shortlisted">Shortlisted</option><option value="interview">Interview</option><option value="rejected">Rejected</option></select>
          <select id="dashSort"><option value="score">Best score first</option><option value="date">Newest first</option><option value="name">Name A-Z</option></select>
        </div>
        <div id="dashList"></div>`;
      ['dashSearch', 'dashLevel', 'dashSort', 'dashStatus'].forEach(id => document.getElementById(id).addEventListener('input', renderCands));
      renderCands();
    }

    function renderCands() {
      const d = window._dash;
      if (!d) return;
      const q = document.getElementById('dashSearch').value.trim().toLowerCase();
      const lvl = document.getElementById('dashLevel').value;
      const st = document.getElementById('dashStatus').value;
      const sort = document.getElementById('dashSort').value;
      const list = d.candidates.filter(c => (!lvl || c.level === lvl) && (!st || c.status === st) && (!q || (c.name + ' ' + c.fileName).toLowerCase().includes(q)));
      if (sort === 'date') list.sort((a, b) => new Date(b.date) - new Date(a.date));
      else if (sort === 'name') list.sort((a, b) => (a.name || '').localeCompare(b.name || ''));
      else list.sort((a, b) => (b.match ?? -1) - (a.match ?? -1) || (b.ats ?? 0) - (a.ats ?? 0));

      window._dashShown = list;
      const box = document.getElementById('dashList');
      if (!list.length) { box.innerHTML = '<div class="history-empty">No candidate matches these filters.</div>'; return; }
      box.innerHTML = list.map(c => `
        <div class="dash-row">
          <div style="min-width:0"><div class="dash-name" dir="auto">${esc(c.name)}</div>
            <div class="dash-sub">${esc(c.level)}${c.years != null ? ' · ' + esc(c.years) + ' yrs' : ''} · ${esc(c.fileName)} · ${new Date(c.date).toLocaleDateString()}</div></div>
          <div class="dash-num"><b>${c.ats ?? '—'}</b><small>ATS</small></div>
          <div class="dash-num"><b>${c.match ?? '—'}</b><small>Match</small></div>
          <button class="rank-view-btn" style="margin:0" data-id="${esc(c.id)}"><i class="fa-solid fa-magnifying-glass-chart"></i> View</button>
          ${pipeHtml(c)}
        </div>`).join('');
      box.querySelectorAll('.rank-view-btn').forEach(b => b.addEventListener('click', () => dashView(b.dataset.id)));
      bindPipe(box);
    }

    async function dashView(id) {
      try {
        const res = await fetch(API + '/api/history/' + id, { headers: authHeaders() });
        if (!res.ok) throw new Error('Not found');
        const full = await res.json();
        document.getElementById('tab-dashboard').classList.remove('active');
        renderResults(full.result, !!full.hasJobDescription);
        document.getElementById('backDashBtn').classList.remove('hidden');
      } catch (e) { toast('Could not load this analysis', 'error'); }
    }

    document.getElementById('backDashBtn').addEventListener('click', () => {
      document.getElementById('resultsSection').classList.add('hidden');
      document.getElementById('backDashBtn').classList.add('hidden');
      document.getElementById('uploadSection').classList.remove('hidden');
      document.getElementById('tab-dashboard').classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    // Also fixes the upload card staying hidden after "Back to ranking"
    document.getElementById('backRankBtn').addEventListener('click', () => {
      document.getElementById('uploadSection').classList.remove('hidden');
    });

    // Password rules (keep in sync with passwordProblems in routes/auth.js)
    const PW_RULES = [
      ['8+ characters', p => p.length >= 8],
      ['Uppercase letter', p => /[A-Z]/.test(p)],
      ['Lowercase letter', p => /[a-z]/.test(p)],
      ['Digit', p => /\d/.test(p)],
      ['Special character', p => /[^A-Za-z0-9]/.test(p)]
    ];
    function pwProblems(p) { return PW_RULES.filter(r => !r[1](p)).map(r => r[0]); }
    function updatePwRules() {
      const p = document.getElementById('authPassword').value;
      document.getElementById('pwRules').innerHTML = PW_RULES
        .map(r => `<li class="${r[1](p) ? 'ok' : ''}">${r[1](p) ? '✓' : '○'} ${r[0]}</li>`).join('');
    }
    document.getElementById('authPassword').addEventListener('input', updatePwRules);
    updatePwRules();

    // Email verification step (inside the login/register modal)
    let resendTimer = null;
    function startResendCooldown(sec) {
      const b = document.getElementById('authResend');
      clearInterval(resendTimer);
      let left = sec;
      b.disabled = true;
      b.textContent = 'Resend code (' + left + 's)';
      resendTimer = setInterval(() => {
        left--;
        if (left <= 0) { clearInterval(resendTimer); b.disabled = false; b.textContent = 'Resend code'; }
        else b.textContent = 'Resend code (' + left + 's)';
      }, 1000);
    }
    function showVerifyStep(email, justSent) {
      authMode = 'verify';
      window._verifyEmail = email;
      ['authName', 'authRole', 'authEmail', 'authPassword', 'pwRules'].forEach(id => document.getElementById(id).classList.add('hidden'));
      document.querySelector('.auth-switch').classList.add('hidden');
      document.getElementById('authVerify').classList.remove('hidden');
      document.getElementById('authTitle').textContent = 'Verify your email';
      document.querySelector('.auth-modal .auth-sub').textContent = 'Enter the 6-digit code we sent to ' + email;
      document.getElementById('authSubmit').textContent = 'Verify';
      document.getElementById('authError').textContent = '';
      if (justSent) startResendCooldown(60);
      else { clearInterval(resendTimer); const b = document.getElementById('authResend'); b.disabled = false; b.textContent = 'Resend code'; }
      document.getElementById('authCode').focus();
    }
    function resetVerifyUI() {
      clearInterval(resendTimer);
      document.getElementById('authVerify').classList.add('hidden');
      ['authEmail', 'authPassword'].forEach(id => document.getElementById(id).classList.remove('hidden'));
      document.querySelector('.auth-switch').classList.remove('hidden');
      document.querySelector('.auth-modal .auth-sub').textContent = 'Save your analyses and access them from any device.';
      document.getElementById('authCode').value = '';
    }
    async function submitVerify() {
      const btn = document.getElementById('authSubmit');
      const err = document.getElementById('authError');
      const code = document.getElementById('authCode').value.trim();
      err.textContent = '';
      if (!/^\d{6}$/.test(code)) { err.textContent = 'Enter the 6-digit code.'; return; }
      btn.disabled = true;
      try {
        const res = await fetch(API + '/api/auth/verify', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: window._verifyEmail, code })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Verification failed');
        authToken = data.token;
        try { localStorage.setItem('cvision-token', authToken); } catch (e) { }
        setUser(data.user);
        closeAuth();
        ['authName', 'authEmail', 'authPassword'].forEach(id => document.getElementById(id).value = '');
        toast('Email verified, welcome ' + data.user.name + ' 👋');
      } catch (e) {
        err.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    }
    document.getElementById('authResend').addEventListener('click', async () => {
      if (authMode === 'reset') return resendReset();
      const err = document.getElementById('authError');
      err.textContent = '';
      try {
        const res = await fetch(API + '/api/auth/resend', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: window._verifyEmail })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Could not resend the code');
        toast('New code sent');
        startResendCooldown(60);
      } catch (e) { err.textContent = e.message; }
    });
    document.getElementById('authCode').addEventListener('input', e => { e.target.value = e.target.value.replace(/\D/g, '').slice(0, 6); });
    document.getElementById('authCode').addEventListener('keydown', e => { if (e.key === 'Enter') submitAuth(); });

    // Improve my CV from History (the CV text is stored with the analysis)
    async function rewriteFromHistory(id) {
      const title = document.querySelector('.loading-title');
      title.textContent = 'Rewriting your CV…';
      showLoading();
      try {
        const res = await fetch(API + '/api/history/' + id + '/rewrite', {
          method: 'POST',
          headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
          body: JSON.stringify({ language: getLang('langSelect') })
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'HTTP ' + res.status);
        showRewrite(data);
      } catch (err) {
        toast('Rewrite failed: ' + err.message, 'error');
      } finally {
        hideLoading();
        title.textContent = 'Analyzing CV…';
      }
    }

    // Small helper for the JSON auth routes
    async function authPost(route, body) {
      const res = await fetch(API + '/api/auth/' + route, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body)
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || 'Request failed');
      return data;
    }

    // Forgot password: email -> code + new password
    function showForgotStep() {
      authMode = 'forgot';
      ['authName', 'authRole', 'authPassword', 'pwRules', 'authForgot', 'authVerify'].forEach(id => document.getElementById(id).classList.add('hidden'));
      document.getElementById('authEmail').classList.remove('hidden');
      document.querySelector('.auth-switch').classList.remove('hidden');
      document.getElementById('authSwitchText').textContent = 'Remembered it?';
      document.getElementById('authSwitchBtn').textContent = 'Login';
      document.getElementById('authTitle').textContent = 'Forgot password';
      document.querySelector('.auth-modal .auth-sub').textContent = 'Enter your email and we will send you a 6-digit code.';
      document.getElementById('authSubmit').textContent = 'Send code';
      document.getElementById('authError').textContent = '';
      document.getElementById('authEmail').focus();
    }
    document.getElementById('authForgot').addEventListener('click', showForgotStep);

    async function submitForgot() {
      const btn = document.getElementById('authSubmit');
      const err = document.getElementById('authError');
      const email = document.getElementById('authEmail').value.trim();
      err.textContent = '';
      if (!email) { err.textContent = 'Enter your email.'; return; }
      btn.disabled = true;
      try {
        await authPost('forgot', { email });
        showResetStep(email);
      } catch (e) {
        err.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    }

    function showResetStep(email) {
      authMode = 'reset';
      window._resetEmail = email;
      ['authName', 'authRole', 'authEmail', 'authForgot'].forEach(id => document.getElementById(id).classList.add('hidden'));
      const pw = document.getElementById('authPassword');
      pw.value = '';
      pw.placeholder = 'New password';
      pw.classList.remove('hidden');
      document.getElementById('pwRules').classList.remove('hidden');
      updatePwRules();
      document.getElementById('authVerify').classList.remove('hidden');
      document.getElementById('authCode').value = '';
      document.getElementById('authTitle').textContent = 'Reset password';
      document.querySelector('.auth-modal .auth-sub').textContent = 'If an account exists for ' + email + ', we sent it a 6-digit code. Enter it and choose a new password.';
      document.getElementById('authSubmit').textContent = 'Reset password';
      document.getElementById('authError').textContent = '';
      startResendCooldown(60);
      document.getElementById('authCode').focus();
    }

    async function submitReset() {
      const btn = document.getElementById('authSubmit');
      const err = document.getElementById('authError');
      const code = document.getElementById('authCode').value.trim();
      const password = document.getElementById('authPassword').value;
      err.textContent = '';
      if (!/^\d{6}$/.test(code)) { err.textContent = 'Enter the 6-digit code.'; return; }
      const miss = pwProblems(password);
      if (miss.length) { err.textContent = 'Password needs: ' + miss.join(', '); return; }
      btn.disabled = true;
      try {
        const email = window._resetEmail;
        await authPost('reset', { email, code, password });
        setAuthMode('login');
        document.getElementById('authEmail').value = email;
        document.getElementById('authPassword').value = '';
        toast('Password changed, you can login now');
      } catch (e) {
        err.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    }

    async function resendReset() {
      const err = document.getElementById('authError');
      err.textContent = '';
      try {
        await authPost('forgot', { email: window._resetEmail });
        toast('If the account exists, a new code was sent');
        startResendCooldown(60);
      } catch (e) { err.textContent = e.message; }
    }

    // My account: change password, delete account
    const accOverlay = document.getElementById('accOverlay');
    function updateAccRules() {
      const p = document.getElementById('accNew').value;
      document.getElementById('accRules').innerHTML = PW_RULES
        .map(r => `<li class="${r[1](p) ? 'ok' : ''}">${r[1](p) ? '✓' : '○'} ${r[0]}</li>`).join('');
    }
    document.getElementById('accNew').addEventListener('input', updateAccRules);

    function openAccount() {
      const u = window._user;
      if (!u) return;
      document.getElementById('accInfo').textContent = u.name + ' · ' + u.email + ' · ' + (u.role === 'recruiter' ? 'Recruiter' : 'Candidate');
      ['accCurrent', 'accNew', 'accDelPw'].forEach(id => { document.getElementById(id).value = ''; });
      ['accMsg', 'accDelMsg'].forEach(id => { document.getElementById(id).textContent = ''; });
      updateAccRules();
      accOverlay.classList.remove('hidden');
    }
    function closeAccount() { accOverlay.classList.add('hidden'); }
    document.getElementById('userName').title = 'My account';
    document.getElementById('userName').addEventListener('click', openAccount);
    document.getElementById('accClose').addEventListener('click', closeAccount);
    accOverlay.addEventListener('click', e => { if (e.target === e.currentTarget) closeAccount(); });

    async function accountCall(method, route, body, msgEl, btn, onOk) {
      msgEl.textContent = '';
      btn.disabled = true;
      try {
        const res = await fetch(API + '/api/auth/' + route, {
          method, headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()), body: JSON.stringify(body)
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) { closeAccount(); logout(true); toast('Session expired, please login again', 'error'); return; }
        if (!res.ok) throw new Error(data.error || 'Request failed');
        onOk();
      } catch (e) {
        msgEl.textContent = e.message;
      } finally {
        btn.disabled = false;
      }
    }

    document.getElementById('accChange').addEventListener('click', () => {
      const msg = document.getElementById('accMsg');
      const cur = document.getElementById('accCurrent').value;
      const nw = document.getElementById('accNew').value;
      if (!cur || !nw) { msg.textContent = 'Fill in both fields.'; return; }
      const miss = pwProblems(nw);
      if (miss.length) { msg.textContent = 'Password needs: ' + miss.join(', '); return; }
      accountCall('POST', 'change-password', { currentPassword: cur, newPassword: nw }, msg, document.getElementById('accChange'),
        () => { closeAccount(); toast('Password changed'); });
    });

    document.getElementById('accDelete').addEventListener('click', () => {
      const msg = document.getElementById('accDelMsg');
      const pw = document.getElementById('accDelPw').value;
      if (!pw) { msg.textContent = 'Enter your password to confirm.'; return; }
      if (!confirm('Permanently delete your account and all your analyses? This cannot be undone.')) return;
      accountCall('DELETE', 'account', { password: pw }, msg, document.getElementById('accDelete'), () => {
        closeAccount();
        logout(true);
        try { localStorage.removeItem('cvision-history'); } catch (e) { }
        document.getElementById('resetBtn').click();
        toast('Account deleted');
      });
    });

    // Before / after ATS score shown above the rewritten CV
    function scoreBoard(after) {
      const cur = window._lastResult || {};
      if (!after || typeof after.ats_score !== 'number' || typeof cur.ats_score !== 'number') return '';
      const row = (label, before, now) => {
        const diff = now - before;
        return `<div class="ba-row"><span>${label}</span><b>${before}</b><i class="fa-solid fa-arrow-right"></i><b class="${diff >= 0 ? 'up' : 'down'}">${now}</b><small>(${diff >= 0 ? '+' : ''}${diff})</small></div>`;
      };
      let html = row('ATS score', cur.ats_score, after.ats_score);
      if (typeof cur.match_score === 'number' && typeof after.match_score === 'number') html += row('Job match', cur.match_score, after.match_score);
      return `<div class="ba-box"><p class="rw-h">Before / after (estimated with the same AI scoring)</p>${html}</div>`;
    }

    // Recruiter pipeline: status + note per candidate, CSV export
    const STATUS_LABELS = { new: 'New', shortlisted: 'Shortlisted', interview: 'Interview', rejected: 'Rejected' };

    function findCand(id) {
      return ((window._dash && window._dash.candidates) || []).find(c => String(c.id) === String(id));
    }
    function pipeHtml(c) {
      const st = STATUS_LABELS[c.status] ? c.status : 'new';
      const opts = Object.keys(STATUS_LABELS).map(k => `<option value="${k}"${k === st ? ' selected' : ''}>${STATUS_LABELS[k]}</option>`).join('');
      return `<div class="dash-pipe"><select class="pipe-status st-${st}" data-id="${esc(c.id)}">${opts}</select><input class="pipe-note" data-id="${esc(c.id)}" maxlength="1000" placeholder="Add a note…" value="${esc(c.note || '')}" dir="auto" /></div>`;
    }
    function pipelineInner(d) {
      const counts = {};
      d.candidates.forEach(c => { counts[c.status] = (counts[c.status] || 0) + 1; });
      return Object.keys(STATUS_LABELS).map(k => `<span class="pipe-chip st-${k}">${STATUS_LABELS[k]} <b>${counts[k] || 0}</b></span>`).join('')
        + '<button type="button" class="rank-view-btn" id="dashCsv" style="margin:0 0 0 auto"><i class="fa-solid fa-file-csv"></i> Export CSV</button>';
    }
    function pipelineHtml(d) { return `<div class="pipe-strip" id="pipeStrip">${pipelineInner(d)}</div>`; }

    async function savePipe(id, change) {
      try {
        const res = await fetch(API + '/api/recruiter/candidates/' + id, {
          method: 'PATCH',
          headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
          body: JSON.stringify(change)
        });
        if (res.status === 401) { logout(true); toast('Session expired, please login again', 'error'); return false; }
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'Save failed');
        const c = findCand(id);
        if (c) Object.assign(c, change);
        toast('Saved');
        return true;
      } catch (e) {
        toast(e.message, 'error');
        return false;
      }
    }
    function bindPipe(box) {
      box.querySelectorAll('.pipe-status').forEach(sel => sel.addEventListener('change', async () => {
        if (await savePipe(sel.dataset.id, { status: sel.value })) {
          sel.className = 'pipe-status st-' + sel.value;
          document.getElementById('pipeStrip').innerHTML = pipelineInner(window._dash);
        } else {
          const c = findCand(sel.dataset.id);
          sel.value = c ? c.status : 'new';
        }
      }));
      box.querySelectorAll('.pipe-note').forEach(inp => inp.addEventListener('change', async () => {
        if (!(await savePipe(inp.dataset.id, { note: inp.value.trim() }))) {
          const c = findCand(inp.dataset.id);
          inp.value = c ? (c.note || '') : '';
        }
      }));
    }

    // CSV of what the list currently shows (filters and sorting included)
    function exportCsv() {
      const d = window._dash;
      const list = window._dashShown || (d && d.candidates) || [];
      if (!list.length) { toast('Nothing to export', 'error'); return; }
      const cell = v => {
        let s = String(v == null ? '' : v);
        if (/^[=+\-@\t\r]/.test(s)) s = "'" + s; // stops spreadsheet formula injection
        return '"' + s.replace(/"/g, '""') + '"';
      };
      const rows = [['Name', 'File', 'Level', 'Years', 'ATS', 'Job match', 'Status', 'Note', 'Date']].concat(
        list.map(c => [c.name, c.fileName, c.level, c.years, c.ats, c.match, STATUS_LABELS[c.status] || c.status, c.note, String(c.date).slice(0, 10)])
      );
      const csv = '\uFEFF' + rows.map(r => r.map(cell).join(',')).join('\r\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = 'cvision-candidates-' + new Date().toISOString().slice(0, 10) + '.csv';
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 5000);
    }
    dashBody.addEventListener('click', e => { if (e.target.closest('#dashCsv')) exportCsv(); });

    // Saved job offers (logged-in users): load / save / delete next to the job description boxes
    function fillJobSelects() {
      const jobs = window._jobs || [];
      document.querySelectorAll('.jobs-select').forEach(sel => {
        sel.innerHTML = '<option value="">Saved job offers…</option>' +
          jobs.map(j => `<option value="${esc(j._id)}">${esc(j.title)}</option>`).join('');
      });
    }
    async function refreshJobs() {
      const bars = document.querySelectorAll('.jobs-bar');
      if (!window._user) {
        window._jobs = [];
        bars.forEach(b => b.classList.add('hidden'));
        return;
      }
      bars.forEach(b => b.classList.remove('hidden'));
      try {
        const res = await fetch(API + '/api/jobs', { headers: authHeaders() });
        if (!res.ok) return;
        window._jobs = await res.json();
        fillJobSelects();
      } catch (e) { window._jobs = window._jobs || []; }
    }

    document.addEventListener('click', async e => {
      const bar = e.target.closest('.jobs-bar');
      if (!bar) return;
      const target = document.getElementById(bar.dataset.target);
      const select = bar.querySelector('.jobs-select');
      const jobs = window._jobs || [];

      if (e.target.closest('.jobs-load')) {
        const job = jobs.find(j => String(j._id) === select.value);
        if (!job) { toast('Pick a saved job offer first', 'error'); return; }
        target.value = job.text;
        target.dispatchEvent(new Event('input')); // keeps the ranking button state in sync
      } else if (e.target.closest('.jobs-save')) {
        const text = target.value.trim();
        if (text.length < 20) { toast('Write or paste the job description first', 'error'); return; }
        const title = prompt('Name this job offer', text.split('\n')[0].slice(0, 60));
        if (!title || !title.trim()) return;
        try {
          const res = await fetch(API + '/api/jobs', {
            method: 'POST',
            headers: Object.assign({ 'Content-Type': 'application/json' }, authHeaders()),
            body: JSON.stringify({ title: title.trim(), text })
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || 'Could not save');
          await refreshJobs();
          document.querySelectorAll('.jobs-select').forEach(s => { s.value = String(data.id); });
          toast('Job offer saved');
        } catch (err) { toast(err.message, 'error'); }
      } else if (e.target.closest('.jobs-del')) {
        const job = jobs.find(j => String(j._id) === select.value);
        if (!job) { toast('Pick a saved job offer first', 'error'); return; }
        if (!confirm('Delete the job offer "' + job.title + '"?')) return;
        try {
          const res = await fetch(API + '/api/jobs/' + job._id, { method: 'DELETE', headers: authHeaders() });
          if (!res.ok) throw new Error('Delete failed');
          await refreshJobs();
          toast('Job offer deleted');
        } catch (err) { toast(err.message, 'error'); }
      }
    });

    document.getElementById('year').textContent = new Date().getFullYear();
  </script>
</body>

</html>